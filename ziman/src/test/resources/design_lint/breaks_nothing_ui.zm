// The other half of the fixture: everything here is legal and a lint that cried wolf would say
// otherwise. Keywords in a comment -- if, while, for, val, var -- keywords inside names, and
// keywords inside a string literal.
use controls
use widget

val gap = 8.0
val width = 90.0
val count = 3.0
val strip = width * count

pub fn verify_notify(b: controls.Button, style: controls.Style) -> widget.Widget {
    // Names that contain keywords: verify, notify, interval, forward, available, evaluation.
    return widget.row_of(gap, [
        widget.fixed_of(width, 0.0, controls.button_widget(b, style)),
        widget.expand(widget.flex())
    ])
}

pub fn with_strings(style: controls.Style) -> widget.Widget {
    return widget.label_of("if you var a val, for while", 12.0, style.ink)
}

// **A `widget.Stack` literal, which the dialect permits and this fixture exists to exercise.**
// `row_of` and `column_of` take spacing and children and nothing else, so a literal is the only
// way a design file can put a surface behind a container or align its children other than the
// default -- the two things lib/ui gained surfaces and alignment for. It is here because without
// it no design file contains one, and a reader that stopped treating a struct's values as
// children would pass every check.
pub fn panel(child: widget.Widget, style: controls.Style) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: gap,
        padding: widget.insets_all(width),
        surface: widget.filled(style.ink),
        align: widget.centred(),
        name: "",
        children: [child]
    })
}
