// ------------------------------------------------------------------ history

fn do_list_history(ctx: Context, args: Json) -> Result<Json, string> {
    val limit = try arg_int(args, "limit")
    val entries = try list_history(current_storage(ctx), limit)
    val out = mutable_array_new<Json>()
    for e in entries {
        push(out, history_entry_to_json(e))
    }
    return ok(Json.JArray(snapshot(out)))
}

// ------------------------------------------------------------------ scenarios

fn do_list_scenarios(ctx: Context, args: Json) -> Result<Json, string> {
    return string_list_answer(list_scenarios(current_storage(ctx)))
}

fn do_load_scenario(ctx: Context, args: Json) -> Result<Json, string> {
    val name = try arg_string(args, "name")
    return ok(scenario_to_json(try load_scenario(current_storage(ctx), name)))
}

fn do_save_scenario(ctx: Context, args: Json) -> Result<Json, string> {
    val scenario = try scenario_from_json(try arg_object(args, "scenario"))
    try save_scenario(current_storage(ctx), scenario)
    return ok(null_answer)
}

fn do_delete_scenario(ctx: Context, args: Json) -> Result<Json, string> {
    val name = try arg_string(args, "name")
    try delete_scenario(current_storage(ctx), name)
    return ok(null_answer)
}

fn do_run_scenario(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val name = try arg_string(args, "name")
    val env_name = try arg_optional_string(args, "envName")
    val overrides = try arg_pairs(args, "overrides")
    val scenario = try load_scenario(store, name)
    return ok(scenario_run_to_json(try scenario_run.run(scenario, store, env_name, overrides)))
}

// ------------------------------------------------------------------ sending

// Resolve variables, send, record history, and -- on a 2xx with extraction rules -- apply them and
// write the session, in one round trip.
//
// **The request comes from the caller, not from storage.** It is either a saved request the
// frontend loaded and possibly edited, or an ad-hoc one typed into the editor; this command cannot
// tell and does not need to, because nothing here touches collection storage. That is why the whole
// `SavedRequest` is an argument rather than a collection-and-path pair.
//
// Every step is `curly run`'s, in `curly run`'s order, through the same `core/` functions -- the
// variable precedence especially, which is `scenario_run.merged_variables` and not a second copy.
fn do_send_request(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val saved = try saved_request_from_json(try arg_object(args, "saved"))
    val env_name = try arg_optional_string(args, "envName")
    val overrides = try arg_pairs(args, "overrides")

    val variables = try merged_variables(store, env_name, overrides)
    val request = try into_request(try resolve_request(saved, variables))
    val response = try exec.send(request)
    // A failure to record history never fails the request: the exchange happened and the caller
    // wants the response. The same rule, and the same `val _`, as `cli/execute` and `tui/app`.
    val _ = append_history(store, history_entry_of(request, response))

    val extracted = mutable_array_new<Extracted>()
    // **Only a 2xx is extracted from**, matching `run` and the bridge: a failed login has no token
    // to pull out, and that is an expected absence rather than a problem to report.
    if response.status >= 200 && response.status < 300 && len(saved.extract) > 0 {
        val scope = switch env_name {
            Some(name) { name }
            None { "global" }
        }
        val found = try apply(saved.extract, response, variables)
        var session = try load_session(store, scope)
        for one in found {
            push(extracted, one)
            session = environment_set(session, one.name, one.value, one.secret)
        }
        try save_session(store, session)
    }
    return ok(send_outcome_to_json(SendOutcome { response: response, extracted: snapshot(extracted) }))
}

// ------------------------------------------------------------------ the table

// The whole surface, in the order the Tauri shell's `src-tauri/src/lib.rs` listed it in its
// `invoke_handler`, so the two can be read side by side and a missing one is visible.
pub fn commands() -> [Command] {
    return [
        Command { name: "open_project", run: do_open_project },
        Command { name: "resolve_default_project", run: do_resolve_default_project },
        Command { name: "list_collections", run: do_list_collections },
        Command { name: "load_collection", run: do_load_collection },
        Command { name: "save_collection", run: do_save_collection },
        Command { name: "delete_collection", run: do_delete_collection },
        Command { name: "add_request", run: do_add_request },
        Command { name: "rename_or_move_request", run: do_rename_or_move_request },
        Command { name: "duplicate_request", run: do_duplicate_request },
        Command { name: "remove_request", run: do_remove_request },
        Command { name: "add_folder", run: do_add_folder },
        Command { name: "remove_folder", run: do_remove_folder },
        Command { name: "list_environments", run: do_list_environments },
        Command { name: "load_environment", run: do_load_environment },
        Command { name: "save_environment", run: do_save_environment },
        Command { name: "delete_environment", run: do_delete_environment },
        Command { name: "load_session", run: do_load_session },
        Command { name: "save_session", run: do_save_session },
        Command { name: "clear_session", run: do_clear_session },
        Command { name: "list_history", run: do_list_history },
        Command { name: "list_scenarios", run: do_list_scenarios },
        Command { name: "load_scenario", run: do_load_scenario },
        Command { name: "save_scenario", run: do_save_scenario },
        Command { name: "delete_scenario", run: do_delete_scenario },
        Command { name: "run_scenario", run: do_run_scenario },
        Command { name: "send_request", run: do_send_request }
    ]
}

pub fn find_command(name: string) -> Option<Command> {
    for one in commands() {
        if one.name == name {
            return Option<Command>.Some(one)
        }
    }
    return Option<Command>.None
}

// Run a command by name, or say that there is no such command -- the one entry point the HTTP layer
// needs, so that layer holds no knowledge of the surface at all.
pub fn call(ctx: Context, name: string, args: Json) -> Result<Json, string> {
    return switch find_command(name) {
        Some(one) {
            val go = one.run
            go(ctx, args)
        }
        None { err(concat("no such command: ", name)) }
    }
}
