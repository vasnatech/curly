use core/saved.saved_request_from_json
use core/scenario.scenario_from_json
use core/scenario.scenario_to_json
use core/scenario_run
use core/scenario_run.merged_variables
use core/storage.Storage
use core/storage.append_history
use core/storage.clear_session
use core/storage.delete_collection
use core/storage.delete_environment
