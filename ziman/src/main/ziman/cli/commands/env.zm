// `curly env` -- the named `{{variable}}` sets a request is resolved against.
//
// **Every line of output here is compared against the Rust CLI's character for character** by
// `parity.sh`, so the wording and the punctuation are copied rather than paraphrased. A message
// that reads better but differs is a diff somebody has to investigate.
use cli/args.Parsed
use cli/args.has_switch
use cli/args.parse_assignment
use cli/args.value_of
use core/import/postman.import_environment
use core/saved.Environment
use core/saved.environment_set
use core/saved.environment_unset
use core/storage.Storage
use core/storage.delete_environment
use core/storage.list_environments
use core/storage.load_environment
use core/storage.load_environment_opt
use core/storage.save_environment
use fs

pub fn run(action: string, rest: Parsed, store: Storage) -> Result<unit, string> {
    if action == "list" {
        val names = try list_environments(store)
        if len(names) == 0 {
            print("no environments yet — create one with: curly env set <name> KEY=VALUE")
            return ok(unit)
        }
        for name in names {
            print(name)
        }
        return ok(unit)
    }
    if action == "show" {
        val name = try one_positional(rest, "env show <name>")
        val env = try load_environment(store, name)
        if len(env.variables) == 0 {
            print(prelude.format("environment \"{}\" has no variables yet", name))
            return ok(unit)
        }
        for v in env.variables {
            // A secret is masked here and in `session show`. **Masked, not encrypted** -- the file
            // on disk holds the value in the clear, which is why `init` gitignores environments.
            print(prelude.format("{}={}", v.key, if v.secret { "***" } else { v.value }))
        }
        return ok(unit)
    }
    if action == "set" {
        if len(rest.positionals) < 2 {
            return err("env set takes a name and KEY=VALUE")
        }
        val name = rest.positionals[0]
        val assignment = try parse_assignment(rest.positionals[1], "env set")
        val existing = switch try load_environment_opt(store, name) {
            Some(found) { found }
            None { Environment { name: name, variables: [] } }
        }
        val updated = environment_set(existing, assignment.key, assignment.value, has_switch(rest, "secret"))
        try save_environment(store, updated)
        print(prelude.format("set {} in environment \"{}\"", assignment.key, name))
        return ok(unit)
    }
    if action == "unset" {
        if len(rest.positionals) < 2 {
            return err("env unset takes a name and a key")
        }
        val name = rest.positionals[0]
        val key = rest.positionals[1]
        val env = try load_environment(store, name)
        val outcome = environment_unset(env, key)
        if !outcome.removed {
            return err(prelude.format("environment \"{}\" has no variable named \"{}\"", name, key))
        }
        try save_environment(store, outcome.environment)
        print(prelude.format("removed {} from environment \"{}\"", key, name))
        return ok(unit)
    }
    if action == "delete" {
        val name = try one_positional(rest, "env delete <name>")
        try delete_environment(store, name)
        print(prelude.format("deleted environment \"{}\"", name))
        return ok(unit)
    }
    if action == "import-postman" {
        val path = try one_positional(rest, "env import-postman <path>")
        val document = switch fs.read_text(path) {
            Ok(t) { t }
            Err(e) { return err(concat("failed to read ", path, ": ", fs.fs_error_message(e))) }
        }
        val env = try import_environment(document, value_of(rest, "as"))
        // **Refused rather than merged**, so an import cannot quietly overwrite variables somebody
        // set by hand.
        if is_Some(try load_environment_opt(store, env.name)) {
            return err(prelude.format(
                "environment \"{}\" already exists (delete it first to re-import)",
                env.name
            ))
        }
        try save_environment(store, env)
        print(prelude.format("imported {} variable(s) into environment \"{}\"", str(len(env.variables)), env.name))
        return ok(unit)
    }
    return err(concat("unknown env command: ", action))
}

fn one_positional(rest: Parsed, usage: string) -> Result<string, string> {
    if len(rest.positionals) == 0 {
        return err(concat("usage: curly ", usage))
    }
    return ok(rest.positionals[0])
}
