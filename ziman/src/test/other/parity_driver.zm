// Drives the Ziman implementation for `parity.sh`, which compares it against the Rust binary over
// the same `.curly/` tree. One case per `CURLY_CASE`, each printing exactly what the corresponding
// Rust command prints, so the comparison is a plain `diff` and not a parser.
//
// **This is not a test of the Ziman side on its own** -- `src/test/unit` does that. It exists
// because "the Ziman implementation replaces the Rust one" is only true if the two agree, and the
// cheapest way to know is to ask both the same question and compare the answers.
use core/collection.add_folder
use core/collection.add_request
use core/collection.duplicate_request
use core/collection.remove_folder
use core/collection.remove_request
use core/collection.rename_or_move_request
use core/exec.ResponseSummary
use core/extraction.Extracted
use core/import/curl.import_curl
use core/import/postman.import_collection
use core/saved.Collection
use core/saved.SavedRequest
use core/saved.collection_from_json
use core/saved.collection_to_json
use core/scenario.scenario_from_json
use core/scenario_run.ScenarioRun
use core/scenario_run.StepLog
use core/scenario_run.StepOutcome
use core/storage.list_collections
use core/storage.list_environments
use core/storage.slugify
use core/storage.storage_of
use fs
use http.Header
use json
use os
use server/wire.extracted_to_json
use server/wire.response_summary_to_json
use server/wire.scenario_run_to_json
use uuid.uuid_new

fn env_or(name: string, fallback: string) -> string {
    return switch os.get_env(name) {
        Some(v) { v }
        None { fallback }
    }
}

fn print_names(r: Result<[string], string>) {
    val none: [string] = []
    for name in switch r {
        Ok(found) { found }
        Err(_) { none }
    } {
        print(name)
    }
}

// The HTTP API's five own JSON shapes, printed so they can be diffed against serde's. The Rust
// side of this is `cargo run --example wire_shapes -p curly-core`, which prints the same values
// from the real structs -- the only honest source for shapes that are serde's conventions rather
// than curly's, and which therefore appear nowhere in curly's source: `Duration` is
// `{"secs","nanos"}`, a `Vec<u8>` is an array of numbers, and an enum with no serde attributes is
// externally tagged.
//
// `ProjectInfo` and `SendOutcome` are not here because they live in the Tauri crate rather than in
// `curly-core`, so the example cannot print them from the real structs; both are flat two-field
// wrappers over the shapes that ARE here.
fn print_wire_shapes() {
    val summary = ResponseSummary {
        status: 201,
        headers: [
            Header { name: "content-type", value: "application/json" },
            Header { name: "x-request-id", value: "abc-123" }
        ],
        // The target's 0xff, decoded lossily. Written as the character itself: Ziman has no `\u`
        // escape and a string literal carries UTF-8 directly.
        body: "{\"a\":�}",
        body_bytes: [123b, 34b, 97b, 34b, 58b, 255b, 125b],
        elapsed_millis: 1234
    }
    print(json.format(response_summary_to_json(summary)))
    print(json.format(response_summary_to_json(ResponseSummary {
        status: 204,
        headers: [],
        body: "",
        body_bytes: [],
        elapsed_millis: 0
    })))
    print(json.format(extracted_to_json(Extracted { name: "TOKEN", value: "s3cret", secret: true })))
    print(json.format(extracted_to_json(Extracted { name: "id", value: "42", secret: false })))
    print(json.format(scenario_run_to_json(ScenarioRun {
        outcome: StepOutcome.Ok,
        steps: [
            StepLog {
                reference: "auth/login",
                method: "POST",
                url: "https://example.com/login",
                status: Some(200),
                error: None,
                extracted: ["TOKEN"]
            }
        ]
    })))
    print(json.format(scenario_run_to_json(ScenarioRun {
        outcome: StepOutcome.Halted("a step returned 500"),
        steps: [
            StepLog {
                reference: "health/check",
                method: "GET",
                url: "https://down.example.com/health",
                status: None,
                error: Some("connection refused"),
                extracted: []
            }
        ]
    })))
    print(json.format(scenario_run_to_json(ScenarioRun { outcome: StepOutcome.HttpFailure, steps: [] })))
}

fn main() {
    val case = env_or("CURLY_CASE", "list-collections")
    val root = env_or("CURLY_ROOT", ".curly")
    val s = storage_of(root)

    if case == "wire-shapes" {
        print_wire_shapes()
        return
    }
    if case == "list-collections" {
        print_names(list_collections(s))
        return
    }
    if case == "list-environments" {
        print_names(list_environments(s))
        return
    }
    if case == "slugify" {
        print(slugify(env_or("CURLY_NAME", "")))
        return
    }
    if case == "rewrite-collection" {
        // Read a collection file and write it back out. The bytes must match what the Rust
        // implementation writes for the same input, which is the whole storage-format contract.
        val path = env_or("CURLY_FILE", "")
        val text = switch fs.read_text(path) {
            Ok(t) { t }
            Err(_) {
                os.fatal(concat("cannot read ", path))
                return
            }
        }
        val parsed = switch json.parse(text) {
            Ok(j) { j }
            Err(why) {
                os.fatal(concat("not JSON: ", why))
                return
            }
        }
        switch collection_from_json(parsed) {
            Ok(c) { print(json.format(collection_to_json(c), 2)) }
            Err(why) { os.fatal(concat("decode failed: ", why)) }
        }
        return
    }
    if case == "import-postman" {
        import_postman_file(env_or("CURLY_FILE", ""), env_or("CURLY_NAME", "imported"))
        return
    }
    if case == "import-curl" {
        import_curl_command(env_or("CURLY_COMMAND", ""), env_or("CURLY_NAME", "imported"), env_or("CURLY_PATH", "req"))
        return
    }
    if case == "show-scenario" {
        show_scenario(env_or("CURLY_FILE", ""))
        return
    }
    if case == "tree-ops" {
        tree_ops()
        return
    }
    os.fatal(concat("unknown case: ", case))
}

// **The same script of tree operations `parity.sh` drives through the Rust CLI**, so the two
// resulting collection files can be diffed. Ids are minted fresh by `add_request` and
// `duplicate_request` on both sides and so cannot match; the harness normalises them away and
// compares everything else -- names, nesting, ordering, and which operations refused.
fn a_request(url: string) -> SavedRequest {
    return SavedRequest {
        id: uuid_new(),
        name: "placeholder",
        method: "GET",
        url: url,
        query_params: [],
        headers: [],
        body: None,
        auth: None,
        extract: []
    }
}

fn must_add(c: Collection, path: string) -> Collection {
    return switch add_request(c, path, a_request(concat("https://example.com/", path))) {
        Ok(out) { out }
        Err(why) {
            os.fatal(concat("add_request failed: ", why))
            c
        }
    }
}

fn tree_ops() {
    var c = Collection { id: uuid_new(), name: "Parity", folders: [], requests: [] }
    c = must_add(c, "login")
    c = must_add(c, "Auth/OAuth/refresh")
    c = must_add(c, "Auth/logout")
    c = add_folder(c, "Archive/Old")
    c = switch rename_or_move_request(c, "login", "Auth/signin") {
        Ok(out) { out }
        Err(why) {
            os.fatal(concat("rename failed: ", why))
            c
        }
    }
    c = switch duplicate_request(c, "Auth/logout", "Archive/Old/logout-copy") {
        Ok(out) { out }
        Err(why) {
            os.fatal(concat("duplicate failed: ", why))
            c
        }
    }
    c = remove_request(c, "Auth/OAuth/refresh").collection
    c = switch remove_folder(c, "Auth/OAuth", false) {
        Ok(out) { out.collection }
        Err(why) {
            os.fatal(concat("remove_folder failed: ", why))
            c
        }
    }
    print(json.format(collection_to_json(c), 2))
}

// **`curly scenario show`, reproduced exactly** (`commands/scenario.rs:63-66`): the name, then one
// indented `alias -> collection` per import, then the top-level step count. Rust iterates a
// `BTreeMap`, so the imports come out in alias order and this sorts to match.
//
// A small output, but it exercises the whole scenario codec -- a file that decoded to the wrong
// shape would show the wrong step count or lose an import.
fn show_scenario(path: string) {
    val text = switch fs.read_text(path) {
        Ok(t) { t }
        Err(_) {
            os.fatal(concat("cannot read ", path))
            return
        }
    }
    val parsed = switch json.parse(text) {
        Ok(j) { j }
        Err(why) {
            os.fatal(concat("not JSON: ", why))
            return
        }
    }
    val s = switch scenario_from_json(parsed) {
        Ok(found) { found }
        Err(why) {
            os.fatal(concat("decode failed: ", why))
            return
        }
    }
    print(s.name)
    val aliases = mutable_array_new<string>()
    for alias in keys(s.imports) {
        push(aliases, alias)
    }
    for alias in sort(snapshot(aliases)) {
        print(prelude.format("  {} -> {}", alias, get_or(s.imports, alias, "")))
    }
    print(prelude.format("  {} top-level step(s)", str(len(s.requests.items))))
}

// **The name is overridden, because `curly collections import postman <COLLECTION> <PATH>` does**:
// its first argument wins over the file's own `info.name`, so comparing the two outputs means doing
// the same here.
fn import_postman_file(path: string, name: string) {
    val text = switch fs.read_text(path) {
        Ok(t) { t }
        Err(_) {
            os.fatal(concat("cannot read ", path))
            return
        }
    }
    switch import_collection(text) {
        Ok(c) { print(json.format(collection_to_json(with c { name: name }), 2)) }
        Err(why) { os.fatal(concat("import failed: ", why)) }
    }
}

// The Rust CLI stores an imported curl command into a collection at a request path, so this builds
// the same one-request collection rather than printing a bare request -- otherwise there would be
// nothing comparable on the other side.
fn import_curl_command(command: string, collection_name: string, request_path: string) {
    val request = switch import_curl(request_path, command) {
        Ok(r) { r }
        Err(why) {
            os.fatal(concat("import failed: ", why))
            return
        }
    }
    val empty = Collection { id: uuid_new(), name: collection_name, folders: [], requests: [] }
    switch add_request(empty, request_path, request) {
        Ok(c) { print(json.format(collection_to_json(c), 2)) }
        Err(why) { os.fatal(concat("add failed: ", why)) }
    }
}
