use uuid.uuid_new

// The open project, and nothing else. It has to be *changeable* because two commands replace it:
// `open_project` and `resolve_default_project` are how the user changes projects without restarting
// the app, exactly as the bridge's `Mutex<Storage>` is.
//
// **It is a thread owning the value, reached over a channel, and it cannot be a `Mutable`.** That
// was the first thing tried and it fails at run time, not at compile time: "a Mutable belongs to
// the thread that made it and was used from another thread". `server.serve` runs a thread per
// connection, and a `Mutable` made on the main thread is unusable from any of them -- so the whole
// API answered the server's generic 500 while an unknown command, which never touches the cell,
// answered correctly. Ziman's model is immutable values plus channels, and `core/thread`'s own
// guidance for state that must outlive a connection is exactly this: a thread that owns it,
// reached over a channel.
//
// The keeper hands out a copy and takes a replacement; it never does I/O. So a command reads the
// root once and then works on its own value, and a project opened by another request half way
// through cannot change which root this one writes to.
enum Ask {
    // Reply with the open project, on the channel the asker brought.
    Read(Channel<Storage>)
    // Make this the open project from now on.
    Write(Storage)
}

pub struct Context {
    asks: Channel<Ask>
}

fn keeper(asks: Channel<Ask>, initial: Storage) {
    var current = initial
    while true {
        switch receive(asks) {
            Read(reply) { send(reply, current) }
            Write(next) { current = next }
        }
    }
}

pub fn context_of(store: Storage) -> Context {
    val asks: Channel<Ask> = channel_new()
    spawn keeper(asks, store)
    return Context { asks: asks }
}

pub fn current_storage(ctx: Context) -> Storage {
    // A reply channel per ask, so two threads asking at once cannot be handed each other's answer.
    val reply: Channel<Storage> = channel_new()
    send(ctx.asks, Ask.Read(reply))
    return receive(reply)
}

fn open(ctx: Context, store: Storage) {
    send(ctx.asks, Ask.Write(store))
}

// One command: the name the frontend calls it by, and what it does.
pub struct Command {
    name: string
    run: fn(Context, Json) -> Result<Json, string>
}

// ------------------------------------------------------------------ arguments

// A command's arguments arrive as one JSON object, the same one `invoke`'s second parameter is.
// These are the four shapes of argument the whole surface uses.
fn arg_string(args: Json, key: string) -> Result<string, string> {
    return json.require_string(args, key)
}

fn arg_bool(args: Json, key: string) -> Result<bool, string> {
    return json.require_bool(args, key)
}

fn arg_int(args: Json, key: string) -> Result<int, string> {
    return json.require_int(args, key)
}

fn arg_object(args: Json, key: string) -> Result<Json, string> {
    return json.require(args, key)
}

// An argument that may be absent **or** explicitly `null`: `envName` is `string | null` on the
// frontend, where null means "no environment selected" rather than "I forgot to pass it". Both have
// to mean the same thing, because `JSON.stringify` drops an `undefined` value and keeps a `null`
// one -- so the same frontend call arrives either way depending on how the caller spelled it.
fn arg_optional_string(args: Json, key: string) -> Result<Option<string>, string> {
    return switch json.get(args, key) {
        None { ok(Option<string>.None) }
        Some(found) {
            if Json.is_JNull(found) {
                ok(Option<string>.None)
            } else {
                switch json.string_from_json(found) {
                    Ok(text) { ok(Option<string>.Some(text)) }
                    Err(why) { err(concat(concat(key, ": "), why)) }
                }
            }
        }
    }
}

// `Vec<(String, String)>` -- an array of two-element arrays, the same shape a form field takes on
// disk, so `core/saved`'s own pair decoder does the work.
fn arg_pairs(args: Json, key: string) -> Result<[Pair], string> {
    val found = switch json.get(args, key) {
        Some(j) { j }
        None { return ok([]) }
    }
    if Json.is_JNull(found) {
        return ok([])
    }
    val out = mutable_array_new<Pair>()
    for one in try json_array(found, key) {
        push(out, try pair_from_json(one))
    }
    return ok(snapshot(out))
}

// `Json` has no `_` arm to fall through to -- a variant pattern must name a variant -- so a
// one-armed `if` and a refusal underneath is how a shape is tested.
fn json_array(j: Json, what: string) -> Result<[Json], string> {
    if JArray(list) = j {
        return ok(list)
    }
    return err(concat(what, ": expected an array of [name, value] pairs"))
}

// ------------------------------------------------------------------ answers

val null_answer = Json.JNull

fn string_list_answer(r: Result<[string], string>) -> Result<Json, string> {
    val names = try r
    val out = mutable_array_new<Json>()
    for name in names {
        push(out, Json.JString(name))
    }
    return ok(Json.JArray(snapshot(out)))
}

// ------------------------------------------------------------------ the project

fn do_open_project(ctx: Context, args: Json) -> Result<Json, string> {
    val path = try arg_string(args, "path")
    val outcome = try init_project_local(path)
    open(ctx, outcome.storage)
    return ok(project_info_to_json(project_info_of(outcome.storage)))
}

// **Reports the project the server was started with; it does not re-resolve one.** The bridge
// calls `Storage::resolve_default(None)` here because a desktop app has no other idea of where it
// is, but this server was given a root on its command line and `curly`'s own `resolve` already did
// that walk -- explicit `--data-dir`, then `CURLY_DATA_DIR`, then the nearest `.curly` above the
// working directory, then the OS default. Re-running it per request would answer a *different*
// question, from a process whose working directory is wherever the server happens to have been
// started.
//
// This was caught by running it: with `--data-dir` given, a `resolve_default_project` -- which the
// frontend calls first thing on startup -- silently moved the whole session to the OS-wide default,
// and every command after it read the wrong tree. Where no `--data-dir` is in play the two answers
// are identical, which is why it survived the unit tests.
fn do_resolve_default_project(ctx: Context, args: Json) -> Result<Json, string> {
    return ok(project_info_to_json(project_info_of(current_storage(ctx))))
}

// ------------------------------------------------------------------ collections

fn do_list_collections(ctx: Context, args: Json) -> Result<Json, string> {
    return string_list_answer(list_collections(current_storage(ctx)))
}

fn do_load_collection(ctx: Context, args: Json) -> Result<Json, string> {
    val name = try arg_string(args, "name")
    return ok(collection_to_json(try load_collection(current_storage(ctx), name)))
}

fn do_save_collection(ctx: Context, args: Json) -> Result<Json, string> {
    val collection = try collection_from_json(try arg_object(args, "collection"))
    try save_collection(current_storage(ctx), collection)
    return ok(null_answer)
}

fn do_delete_collection(ctx: Context, args: Json) -> Result<Json, string> {
    val name = try arg_string(args, "name")
    try delete_collection(current_storage(ctx), name)
    return ok(null_answer)
}

// **A collection the frontend adds to need not exist yet**, matching the bridge: adding the first
// request to a new name creates the collection rather than refusing. Every other tree operation
// requires it, because moving or removing something inside a collection that is not there is a
// mistake worth reporting.
fn loaded_or_new(store: Storage, name: string) -> Result<Collection, string> {
    return switch try load_collection_opt(store, name) {
        Some(found) { ok(found) }
        None { ok(Collection { id: uuid_new(), name: name, folders: [], requests: [] }) }
    }
}

fn do_add_request(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val name = try arg_string(args, "collection")
    val path = try arg_string(args, "path")
    val request = try saved_request_from_json(try arg_object(args, "request"))
    val collection = try add_request(try loaded_or_new(store, name), path, request)
    try save_collection(store, collection)
    return ok(null_answer)
}

fn do_rename_or_move_request(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val name = try arg_string(args, "collection")
    val old_path = try arg_string(args, "oldPath")
    val new_path = try arg_string(args, "newPath")
    val collection = try rename_or_move_request(try load_collection(store, name), old_path, new_path)
    try save_collection(store, collection)
    return ok(null_answer)
}

fn do_duplicate_request(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val name = try arg_string(args, "collection")
    val path = try arg_string(args, "path")
    val new_path = try arg_string(args, "newPath")
    val collection = try duplicate_request(try load_collection(store, name), path, new_path)
    try save_collection(store, collection)
    return ok(null_answer)
}

// **Saved whether or not anything was removed**, as the bridge is: the answer is whether a request
// was there, and writing the file back unchanged is how the two implementations stay byte-identical
// on a no-op rather than one of them skipping the write.
fn do_remove_request(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val name = try arg_string(args, "collection")
    val path = try arg_string(args, "path")
    val outcome = remove_request(try load_collection(store, name), path)
    try save_collection(store, outcome.collection)
    return ok(Json.JBool(outcome.removed))
}

fn do_add_folder(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val name = try arg_string(args, "collection")
    val path = try arg_string(args, "path")
    try save_collection(store, add_folder(try loaded_or_new(store, name), path))
    return ok(null_answer)
}

fn do_remove_folder(ctx: Context, args: Json) -> Result<Json, string> {
    val store = current_storage(ctx)
    val name = try arg_string(args, "collection")
    val path = try arg_string(args, "path")
    val force = try arg_bool(args, "force")
    val outcome = try remove_folder(try load_collection(store, name), path, force)
    try save_collection(store, outcome.collection)
    return ok(Json.JBool(outcome.removed))
}

