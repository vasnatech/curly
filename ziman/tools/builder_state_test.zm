// The builder's behaviour, with no window, no display and no file.
//
// **Every case here is one the builder was driven by hand to find**, and the point of
// `tools/builder_state.zm` being a separate module is that they are reachable at all: a window
// that opens a display and polls an event queue can be looked at and not asserted on.
//
// The design under test is **a fixture in this file, not the real `request_ui.zm`**. The builder
// is a tool for any design file, so a test tied to one of them would be measuring that file; and
// `request_ui.zm` moves whenever curly's window does, which would make this suite fail for
// reasons that have nothing to do with the builder.
use controls
use focus
use geom
use test
use tools/builder_state
use tools/builder_state.Shown
use tools/read_design
use tools/render_design.Spot
use widget

fn metrics() -> widget.Metrics {
    return widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 7.0 },
        fn(size: float) -> float { return size * 1.4 }
    )
}

fn style() -> controls.Style {
    return controls.default_style()
}

val window_box = geom.rect_of(0.0, 0.0, 1400.0, 900.0)

// A design file in the dialect, small enough to reason about: one record, one part, one root.
fn fixture() -> string {
    return join(separator: "\n", pieces: [
        "use controls",
        "use widget",
        "",
        "val gap = 8.0",
        "val row_height = 30.0",
        "",
        "pub struct Screen {",
        "    name: controls.Entry",
        "    go: controls.Button",
        "}",
        "",
        "pub fn field(name: controls.Entry, style: controls.Style, m: widget.Metrics) -> widget.Widget {",
        "    return widget.row_of(gap, [controls.entry_widget(name, style, m), widget.flex()])",
        "}",
        "",
        "pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {",
        "    return widget.column_of(gap, [",
        "        widget.fixed_of(0.0, row_height, field(it.name, style, m)),",
        "        widget.fixed_of(0.0, row_height, controls.button_widget(it.go, style)),",
        "        widget.expand(widget.flex())",
        "    ])",
        "}",
        ""
    ])
}

fn opened() -> builder_state.State {
    return builder_state.state_of("fixture_ui.zm", fixture())
}

fn laid_of(s: builder_state.State) -> widget.Laid {
    return widget.layout(builder_state.view(s, style(), metrics()), window_box, metrics())
}

fn shown_of(s: builder_state.State, laid: widget.Laid) -> Shown {
    val canvas = builder_state.canvas_of(s, style(), metrics())
    return Shown {
        laid: widget.layout(
            canvas.widget_,
            builder_state.bounds_of(laid, "canvas"),
            metrics()
        ),
        spots: canvas.spots
    }
}

fn acted(s: builder_state.State, input: controls.Input) -> builder_state.Step {
    val laid = laid_of(s)
    return builder_state.step(s, input, laid, shown_of(s, laid), style(), metrics())
}

// A press at the middle of a named box of the *design*, which is the only way a test can click
// something the builder is only drawing.
fn pressed_on_design(s: builder_state.State, name: string) -> builder_state.Step {
    val laid = laid_of(s)
    val shown = shown_of(s, laid)
    val box = builder_state.bounds_of(shown.laid, name)
    return builder_state.step(
        s,
        controls.Input.Press(geom.point_of(box.x + box.width / 2.0, box.y + box.height / 2.0)),
        laid,
        shown,
        style(),
        metrics()
    )
}

// ---- what it opens on

// **`screen` and not the first function in the file.** It is the dialect's one root; opening on a
// helper would show a fragment of a window and call it the window.
#[test]
fn it_opens_on_the_root_and_not_the_first_part() {
    test.assert_eq(builder_state.showing(opened()), "screen")
    test.assert_eq(opened().parts.items[0], "field")
}

#[test]
fn the_inputs_are_the_fields_the_file_declares() {
    val s = opened()
    test.assert_len(2, s.inputs.items)
    test.assert_eq(s.inputs.items[0], "Screen.name: controls.Entry")
    test.assert_eq(s.inputs.items[1], "Screen.go: controls.Button")
}

// **The design's controls are not in the builder's tab order, and that is the whole reason the
// canvas is a second tree.** Rendering a design makes real controls -- a real entry, a real
// button -- and putting them in the builder's own tree would hand them its keystrokes: clicking
// the design's field would type into it instead of selecting it.
#[test]
fn nothing_in_the_design_can_take_the_focus() {
    val s = opened()
    val names = mutable_array_new<string>()
    for one in focus.controls(laid_of(s)) {
        push(names, one.name)
    }
    val reachable = snapshot(names)
    for wanted in ["parts", "source", "apply", "revert", "inputs"] {
        test.assert(contains(reachable, wanted))
    }
    // The fixture's own controls are named after its fields, and neither is here.
    test.assert_false(contains(reachable, "name"))
    test.assert_false(contains(reachable, "go"))
}

// ---- clicking the canvas

#[test]
fn a_press_on_the_canvas_selects_the_node_that_drew_it() {
    val step = pressed_on_design(opened(), "go")
    test.assert_eq(step.state.source.editor.text, "controls.button_widget(it.go, style)")
    test.assert(contains(builder_state.selection_line(step.state), "1.1.2 of screen"))
    test.assert_false(step.write)
}

// A click inside a part reports a node of *that part's* source, which is the file an editor would
// open -- not the one line in the root that called it.
#[test]
fn a_press_inside_a_part_reports_a_node_of_the_part() {
    val step = pressed_on_design(opened(), "name")
    test.assert_eq(step.state.source.editor.text, "controls.entry_widget(name, style, m)")
    test.assert(contains(builder_state.selection_line(step.state), "of field"))
}

// **There is no empty part of a canvas while a component is on it.** The root is laid out at the
// canvas box and every point inside it is inside the root, so a press "on the background" selects
// the root -- which is right, and is not the miss case. This test asserted the opposite first.
#[test]
fn a_press_on_the_background_selects_the_root() {
    val laid = laid_of(opened())
    val box = builder_state.bounds_of(laid, "canvas")
    val low = geom.point_of(box.x + box.width / 2.0, box.y + box.height - 2.0)
    val step = builder_state.step(
        opened(),
        controls.Input.Press(low),
        laid,
        shown_of(opened(), laid),
        style(),
        metrics()
    )
    test.assert(Option.is_Some(step.state.picked))
    test.assert(contains(builder_state.selection_line(step.state), "root of screen"))
}

// **A miss clears the selection rather than keeping it.** An outline left over a node nobody is
// pointing at is a lie about what Apply would rewrite. Reached with nothing on the canvas, which
// is the only way there is nothing under the pointer.
#[test]
fn a_press_with_nothing_on_the_canvas_clears_the_selection() {
    val chosen = pressed_on_design(opened(), "go").state
    test.assert(Option.is_Some(chosen.picked))
    val blank = with chosen { parts: with chosen.parts { selected: 0 - 1 } }
    val laid = laid_of(blank)
    val box = builder_state.bounds_of(laid, "canvas")
    val away = geom.point_of(box.x + box.width / 2.0, box.y + box.height / 2.0)
    val step = builder_state.step(
        blank,
        controls.Input.Press(away),
        laid,
        shown_of(blank, laid),
        style(),
        metrics()
    )
    test.assert(Option.is_None(step.state.picked))
    test.assert_eq(step.state.source.editor.text, "")
}

// ---- choosing a component

// **A new component clears the selection.** A path names a node of one component's tree and means
// something else, or nothing, in another's.
#[test]
fn showing_another_component_clears_the_selection() {
    val chosen = pressed_on_design(opened(), "go").state
    test.assert(Option.is_Some(chosen.picked))
    val moved = with chosen { parts: with chosen.parts { selected: 0 } }
    val step = acted(moved, controls.Input.KeyDown(controls.keystroke_of(controls.Key.Down)))
    test.assert(Option.is_None(step.state.picked))
}

// ---- applying an edit

fn applied(s: builder_state.State) -> builder_state.Step {
    val laid = laid_of(s)
    val box = builder_state.bounds_of(laid, "apply")
    val at = geom.point_of(box.x + box.width / 2.0, box.y + box.height / 2.0)
    val shown = shown_of(s, laid)
    val down = builder_state.step(s, controls.Input.Press(at), laid, shown, style(), metrics())
    return builder_state.step(
        down.state,
        controls.Input.Release(at),
        laid,
        shown,
        style(),
        metrics()
    )
}

#[test]
fn apply_rewrites_the_span_and_leaves_every_other_byte_alone() {
    val s = pressed_on_design(opened(), "go").state
    val edited = with s { source: controls.text_area_of("source", "Source", "widget.flex()", 6) }
    val step = applied(edited)
    test.assert(step.write)
    test.assert(contains(step.state.text, "widget.flex()"))
    test.assert_false(contains(step.state.text, "controls.button_widget(it.go, style)"))
    // Everything else is still there, which is what a span rewrite promises and a regenerated
    // file does not.
    test.assert(contains(step.state.text, "val gap = 8.0"))
    test.assert(contains(step.state.text, "pub struct Screen {"))
    test.assert(contains(step.state.text, "controls.entry_widget(name, style, m)"))
    test.assert_eq(len(lines(step.state.text)), len(lines(fixture())))
}

// **The second Apply has to rewrite the right bytes too**, which is the case a tree that
// remembered its old spans gets wrong: the first edit moves every span after it.
#[test]
fn a_second_apply_lands_on_the_node_and_not_on_stale_bytes() {
    // **Both replacements are distinctive.** The first version of this test put `widget.flex()`
    // in and then asserted it was gone, which the fixture's own `expand(widget.flex())` made
    // false -- a failing test about a working program.
    val first = applied(with pressed_on_design(opened(), "go").state {
        source: controls.text_area_of("source", "Source", "mono_label_one(style)", 6)
    })
    test.assert(contains(first.state.text, "mono_label_one(style)"))
    val again = applied(with first.state {
        source: controls.text_area_of("source", "Source", "mono_label_two(style)", 6)
    })
    test.assert(again.write)
    test.assert(contains(again.state.text, "mono_label_two(style)"))
    test.assert_false(contains(again.state.text, "mono_label_one(style)"))
    // **The bytes *after* the node are the ones that matter here**, and the first version of this
    // test did not look at them. A stale span is the right length for the text that used to be
    // there, so a second rewrite eats whatever follows -- and everything before the node is
    // untouched either way, which is why asserting on it passed against the defect.
    test.assert(contains(again.state.text, "widget.expand(widget.flex())"))
    test.assert(contains(again.state.text, "controls.entry_widget(name, style, m)"))
    test.assert(contains(again.state.text, "val gap = 8.0"))
    // And it still parses as the same file: two components, one record.
    test.assert_len(2, read_design.components_of(again.state.text))
    test.assert_len(1, read_design.records_of(again.state.text))
}

#[test]
fn apply_with_nothing_selected_writes_nothing() {
    val step = applied(opened())
    test.assert_false(step.write)
    test.assert_eq(step.state.text, fixture())
}

// Revert puts the file's own bytes back in the box, so a half-typed edit can be abandoned.
#[test]
fn revert_restores_what_the_file_says() {
    val s = pressed_on_design(opened(), "go").state
    val typed = with s { source: controls.text_area_of("source", "Source", "nonsense", 6) }
    val laid = laid_of(typed)
    val box = builder_state.bounds_of(laid, "revert")
    val at = geom.point_of(box.x + box.width / 2.0, box.y + box.height / 2.0)
    val shown = shown_of(typed, laid)
    val down = builder_state.step(typed, controls.Input.Press(at), laid, shown, style(), metrics())
    val up = builder_state.step(
        down.state,
        controls.Input.Release(at),
        laid,
        shown,
        style(),
        metrics()
    )
    test.assert_eq(up.state.source.editor.text, "controls.button_widget(it.go, style)")
}

// ---- the keyboard

#[test]
fn tab_moves_the_focus_and_reaches_no_control() {
    val s = opened()
    val step = acted(s, controls.Input.KeyDown(controls.keystroke_of(controls.Key.Tab)))
    test.assert(step.state.focused != s.focused)
    test.assert_false(step.write)
}

// ---- where a new node would go

// **Inserting asks a different question from selecting**: a point selects the node it is *on*,
// and the slot is the gap *after* whatever that turned out to be -- in the nearest list above it,
// which is rarely the node's own parent.

fn slot_text(got: Option<builder_state.Slot>) -> string {
    return switch got {
        Some(slot) {
            format(
                "{} of {} at {}",
                read_design.path_text(slot.list),
                slot.component,
                str(slot.index)
            )
        }
        None { "(none)" }
    }
}

fn slot_after(name: string) -> Option<builder_state.Slot> {
    val s = pressed_on_design(opened(), name).state
    val laid = laid_of(s)
    return builder_state.slot_after_selection(s, shown_of(s, laid))
}

// The fixture's root is a column of three and the button is inside its second child, so the gap
// is at index 2 -- **the list above the node, not its own parent**, which is the `widget.fixed_of`
// wrapping it. Looking only one step up finds that `Call` and gives up, which would make every
// child of every container in the file undroppable.
#[test]
fn the_slot_is_in_the_nearest_list_above_the_selection() {
    test.assert_eq(slot_text(slot_after("go")), "1 of screen at 2")
}

// A node inside a part reports a gap in *that part's* list, which is the file an editor would
// open to make the change.
#[test]
fn a_slot_inside_a_part_belongs_to_the_part() {
    test.assert(contains(slot_text(slot_after("name")), "of field"))
}

// The root is in no list, so there is no gap beside it: a node has to have a parent before it can
// have a neighbour.
#[test]
fn the_root_offers_no_slot() {
    val laid = laid_of(opened())
    val box = builder_state.bounds_of(laid, "canvas")
    val low = geom.point_of(box.x + box.width / 2.0, box.y + box.height - 2.0)
    val s = builder_state.step(
        opened(),
        controls.Input.Press(low),
        laid,
        shown_of(opened(), laid),
        style(),
        metrics()
    ).state
    test.assert_eq(slot_text(builder_state.slot_after_selection(s, shown_of(s, laid_of(s)))), "(none)")
}

// **The line is drawn along the list's axis, read from the call that owns it.** The fixture's
// root is a column, so the gap after a full-width row is a horizontal line under it -- not a
// vertical one down its right-hand edge, which is what taking the child's own aspect gives.
#[test]
fn the_line_runs_across_the_list_and_not_across_the_child() {
    switch slot_after("go") {
        Some(slot) { test.assert(slot.at.width > slot.at.height) }
        None { test.fail("no slot") }
    }
}

// The byte offset an insertion lands at is **before the item that is there now**, so the new node
// takes its place in the order and the old one follows it.
#[test]
fn an_insertion_lands_before_the_item_it_displaces() {
    val s = pressed_on_design(opened(), "go").state
    switch slot_after("go") {
        Some(slot) {
            switch builder_state.insertion_of(s, slot, "x") {
                Some(edit) {
                    test.assert_eq(edit.at.from, edit.at.to)
                    // What is at that offset is the start of the node being displaced...
                    test.assert(starts_with(
                        substring(s.text, edit.at.from, len(s.text)),
                        "widget.expand(widget.flex())"
                    ))
                    // ...so the comma goes after the new text, to separate it from that node.
                    test.assert_eq(edit.text, "x, ")
                }
                None { test.fail("no insertion point") }
            }
        }
        None { test.fail("no slot") }
    }
}

// ...and past the end of the list it lands after the last item, where there is no comma yet.
#[test]
fn an_insertion_at_the_end_lands_after_the_last_item() {
    val s = pressed_on_design(opened(), "go").state
    switch slot_after("go") {
        Some(slot) {
            switch builder_state.insertion_of(s, with slot { index: 99 }, "x") {
                Some(edit) {
                    test.assert_eq(edit.at.from, edit.at.to)
                    test.assert(starts_with(substring(s.text, edit.at.from, len(s.text)), "\n    ])"))
                    test.assert_eq(edit.text, ", x")
                }
                None { test.fail("no insertion point") }
            }
        }
        None { test.fail("no slot") }
    }
}

// ---- adding a node

fn with_palette(s: builder_state.State, which: int) -> builder_state.State {
    return with s { palette: with s.palette { selected: which } }
}

fn pressing(s: builder_state.State, name: string) -> builder_state.Step {
    val laid = laid_of(s)
    val box = builder_state.bounds_of(laid, name)
    val at = geom.point_of(box.x + box.width / 2.0, box.y + box.height / 2.0)
    val shown = shown_of(s, laid)
    val down = builder_state.step(s, controls.Input.Press(at), laid, shown, style(), metrics())
    return builder_state.step(
        down.state,
        controls.Input.Release(at),
        laid,
        shown,
        style(),
        metrics()
    )
}

// **The file still parses afterwards, which is the only thing that makes this an edit rather
// than damage.** A splice that produced `[a, bwidget.flex()]` would place the text correctly and
// destroy the component.
#[test]
fn adding_a_node_leaves_a_file_that_still_parses() {
    val chosen = pressed_on_design(opened(), "go").state
    val step = pressing(with_palette(chosen, 0), "insert")
    test.assert(step.write)
    test.assert(contains(step.state.text, "widget.flex()"))
    test.assert_len(2, read_design.components_of(step.state.text))
    // ...and the root is still the root, not a casualty of the splice.
    test.assert_eq(read_design.components_of(step.state.text)[1].name, "screen")
}

// It goes *after* the selection, which is what the button says.
//
// **Asserted on the parsed list, not on where the text landed**, which is what the first version
// did: the fixture's `field` already contains a `widget.flex()` earlier in the file than the
// button, so a search for the first one can never see the insertion wherever it went. The list
// has four items afterwards and the new one is at index 2, which says it exactly.
#[test]
fn a_new_node_follows_the_one_that_was_selected() {
    val chosen = pressed_on_design(opened(), "go").state
    val text = pressing(with_palette(chosen, 0), "insert").state.text
    val items = root_children(text)
    test.assert_len(4, items)
    test.assert_eq(read_design.text_of(items[1]), "widget.fixed_of")
    test.assert_eq(read_design.text_of(items[2]), "widget.flex")
    test.assert_eq(read_design.text_of(items[3]), "widget.expand")
}

// The children of `screen`'s root column, as the reader sees them after an edit.
fn root_children(text: string) -> [read_design.Node] {
    val none: [read_design.Node] = []
    for c in read_design.components_of(text) {
        if c.name == "screen" {
            val ts = read_design.tokens_of(c.body)
            val start = if len(ts) > 0 && ts[0].text == "return" { 1 } else { 0 }
            val root = read_design.expr_at(ts, start).node
            return switch read_design.node_at(root, read_design.Path { steps: [1] }) {
                Some(node) {
                    switch node {
                        List(got) { got.items }
                        Call(_) { none }
                        Struct(_) { none }
                        Str(_) { none }
                        Num(_) { none }
                        Path(_) { none }
                    }
                }
                None { none }
            }
        }
    }
    return none
}

// Nothing selected is a refusal with a reason, not a write into a guessed place.
#[test]
fn adding_with_nothing_selected_writes_nothing() {
    val step = pressing(with_palette(opened(), 0), "insert")
    test.assert_false(step.write)
    test.assert_eq(step.state.text, fixture())
}

// ...and the same when the palette has nothing chosen.
#[test]
fn adding_with_nothing_chosen_writes_nothing() {
    val chosen = pressed_on_design(opened(), "go").state
    val step = pressing(with_palette(chosen, 0 - 1), "insert")
    test.assert_false(step.write)
    test.assert_eq(step.state.text, fixture())
}

// A container goes in whole, brackets and all, so the next thing can be added inside it.
#[test]
fn a_container_can_be_added_and_then_filled() {
    val chosen = pressed_on_design(opened(), "go").state
    val step = pressing(with_palette(chosen, 2), "insert")
    test.assert(step.write)
    test.assert(contains(step.state.text, "widget.row_of(8.0, [widget.flex()])"))
    test.assert_len(2, read_design.components_of(step.state.text))
}

// ---- deleting a node

// **The file still parses, which is the only thing that makes this an edit rather than damage.**
// Cutting the item and leaving its comma gives `[a, , c]`, which is a parse error in a file
// somebody was halfway through changing.
#[test]
fn deleting_a_middle_item_leaves_a_file_that_parses() {
    val chosen = pressed_on_design(opened(), "go").state
    val step = pressing(chosen, "remove")
    test.assert(step.write)
    val items = root_children(step.state.text)
    test.assert_len(2, items)
    test.assert_eq(read_design.text_of(items[0]), "widget.fixed_of")
    test.assert_eq(read_design.text_of(items[1]), "widget.expand")
    test.assert_len(2, read_design.components_of(step.state.text))
}

// The last item takes the comma *before* it instead, which is the other half of the rule.
//
// **Driven through `deletion_of` with a built slot, not by clicking.** The first version pressed
// the bottom of the canvas hoping to land on the last child and wrapped its assertions in
// `if step.write`, so when the press missed the test asserted nothing and passed -- and a mutant
// that cut the last item forwards, past the end of the list, lived through it.
#[test]
fn deleting_the_last_item_takes_the_comma_before_it() {
    val s = pressed_on_design(opened(), "go").state
    switch builder_state.slot_of_selection(s) {
        Some(slot) {
            // The fixture's root list has three items; the last is `widget.expand(...)`.
            val cut = switch builder_state.deletion_of(s, with slot { index: 2 }) {
                Some(one) { one }
                None {
                    test.fail("no cut")
                    read_design.Span { from: 0, to: 0 }
                }
            }
            test.assert(contains(substring(s.text, cut.from, cut.to), ","))
            val after = read_design.with_span_replaced(s.text, cut, "")
            test.assert_len(2, root_children(after))
            test.assert_len(2, read_design.components_of(after))
        }
        None { test.fail("no slot") }
    }
}

// **An empty list is left rather than refused.** A container with nothing in it is a state a
// person passes through on the way to filling it, and a builder that would not let you empty a
// row would make you delete the row and build a new one.
//
// `field`'s body is `widget.row_of(gap, [entry, flex])`, so two cuts empty it.
#[test]
fn the_only_item_can_go_and_leaves_an_empty_list() {
    val s = opened()
    val list = read_design.Path { steps: [1] }
    val one = builder_state.Slot {
        list: list,
        component: "field",
        index: 1,
        at: geom.rect_of(0.0, 0.0, 0.0, 0.0)
    }
    val once = switch builder_state.deletion_of(s, one) {
        Some(cut) { read_design.with_span_replaced(s.text, cut, "") }
        None {
            test.fail("no cut")
            ""
        }
    }
    test.assert_len(2, read_design.components_of(once))
    // Now one item is left, and cutting it leaves the list empty and the file readable.
    val left = builder_state.state_of("fixture_ui.zm", once)
    val empty = switch builder_state.deletion_of(left, with one { index: 0 }) {
        Some(cut) { read_design.with_span_replaced(once, cut, "") }
        None {
            test.fail("no second cut")
            ""
        }
    }
    test.assert(contains(empty, "widget.row_of(gap, [])"))
    test.assert_len(2, read_design.components_of(empty))
}

#[test]
fn deleting_with_nothing_selected_writes_nothing() {
    val step = pressing(opened(), "remove")
    test.assert_false(step.write)
    test.assert_eq(step.state.text, fixture())
}

// **The selection goes with the node.** Its path would name the successor afterwards, so keeping
// it would outline a different node and a second Delete would eat the list.
#[test]
fn deleting_clears_the_selection() {
    val chosen = pressed_on_design(opened(), "go").state
    test.assert(Option.is_Some(chosen.picked))
    test.assert(Option.is_None(pressing(chosen, "remove").state.picked))
}

// ---- moving a node

fn names_of(text: string) -> string {
    val out = mutable_array_new<string>()
    for one in root_children(text) {
        push(out, read_design.text_of(one))
    }
    return join(separator: " ", pieces: snapshot(out))
}

// The fixture's root is `[fixed_of(field), fixed_of(button), expand(flex)]`. The button's row is
// item 1, so Down puts it last.
#[test]
fn down_moves_the_item_past_the_next_one() {
    val chosen = pressed_on_design(opened(), "go").state
    test.assert_eq(names_of(chosen.text), "widget.fixed_of widget.fixed_of widget.expand")
    val step = pressing(chosen, "down")
    test.assert(step.write)
    test.assert_eq(names_of(step.state.text), "widget.fixed_of widget.expand widget.fixed_of")
    // ...and the thing that moved is the one that was selected, not some other row.
    test.assert(contains(step.state.text, "controls.button_widget(it.go, style)"))
    test.assert_len(2, read_design.components_of(step.state.text))
}

// Up is the same machinery the other way, and lands the item before the one above it.
#[test]
fn up_moves_the_item_before_the_previous_one() {
    val chosen = pressed_on_design(opened(), "go").state
    val step = pressing(chosen, "up")
    test.assert(step.write)
    test.assert_eq(names_of(step.state.text), "widget.fixed_of widget.fixed_of widget.expand")
    // Both rows are `fixed_of`, so the order is told by what is inside them: the button first.
    val text = step.state.text
    test.assert(index_of(text, "controls.button_widget", 0) < index_of(text, "field(it.name", 0))
}

// **A move is a cut and a paste with a re-read between**, and this is the case that says the
// re-read is there: moving twice rewrites bytes whose offsets the first move changed.
#[test]
fn a_second_move_lands_where_the_first_one_left_it() {
    val chosen = pressed_on_design(opened(), "go").state
    val once = pressing(chosen, "down").state
    test.assert_eq(names_of(once.text), "widget.fixed_of widget.expand widget.fixed_of")
    // Select the button again -- it is last now -- and bring it back up.
    val again = pressed_on_design(once, "go").state
    val twice = pressing(again, "up")
    test.assert(twice.write)
    test.assert_eq(names_of(twice.state.text), "widget.fixed_of widget.fixed_of widget.expand")
    test.assert_len(2, read_design.components_of(twice.state.text))
}

// The ends refuse rather than wrapping or writing nothing quietly.
#[test]
fn the_ends_of_a_list_refuse_to_move_further() {
    val chosen = pressed_on_design(opened(), "name").state
    val step = pressing(chosen, "up")
    test.assert_false(step.write)
    test.assert_eq(step.state.text, fixture())
    test.assert_eq(step.state.status, "already first")
}

#[test]
fn moving_with_nothing_selected_writes_nothing() {
    val step = pressing(opened(), "down")
    test.assert_false(step.write)
    test.assert_eq(step.state.text, fixture())
}

// ---- undo

// **Four buttons here write to somebody's source the instant they are pressed**, and Delete is
// the one you press by accident. One step back is what makes that recoverable.
#[test]
fn undo_puts_back_what_a_delete_removed() {
    val chosen = pressed_on_design(opened(), "go").state
    val gone = pressing(chosen, "remove").state
    test.assert_eq(names_of(gone.text), "widget.fixed_of widget.expand")
    val back = pressing(gone, "undo")
    test.assert(back.write)
    test.assert_eq(back.state.text, fixture())
}

// It covers every edit, not only Delete, because every edit goes through the same write.
#[test]
fn undo_puts_back_what_a_move_and_an_add_did() {
    val chosen = pressed_on_design(opened(), "go").state
    val moved = pressing(chosen, "down").state
    test.assert_eq(pressing(moved, "undo").state.text, fixture())
    val added = pressing(with_palette(chosen, 0), "insert").state
    test.assert_eq(pressing(added, "undo").state.text, fixture())
}

// **One step, and it clears itself.** There is no redo and no second level: pressing Undo twice
// leaves the file where the first one put it rather than walking further back.
#[test]
fn undo_is_one_step_and_says_so_afterwards() {
    val chosen = pressed_on_design(opened(), "go").state
    val gone = pressing(chosen, "remove").state
    val back = pressing(gone, "undo").state
    test.assert_eq(back.text, fixture())
    val again = pressing(back, "undo")
    test.assert_false(again.write)
    test.assert_eq(again.state.status, "nothing to undo")
    test.assert_eq(again.state.text, fixture())
}

// Nothing has been edited yet, so there is nothing to put back -- and in particular the button
// does not write the file it just read.
#[test]
fn undo_before_any_edit_writes_nothing() {
    val step = pressing(opened(), "undo")
    test.assert_false(step.write)
    test.assert_eq(step.state.status, "nothing to undo")
}

// **The text comes back and the window does not jump.** Which component is on the canvas belongs
// to now, not to the edit, so undoing an edit made while looking at a part leaves you looking at
// that part.
//
// It starts on `field` rather than the default, which is the whole point: the first version of
// this compared two states that were both showing `screen`, so an undo that rebuilt the state
// from scratch -- resetting the canvas to the root -- passed it.
#[test]
fn undo_leaves_the_canvas_where_it_was() {
    val on_field = with opened() { parts: with opened().parts { selected: 0 } }
    test.assert_eq(builder_state.showing(on_field), "field")
    val chosen = pressed_on_design(on_field, "name").state
    val gone = pressing(chosen, "remove").state
    val back = pressing(gone, "undo").state
    test.assert_eq(back.text, fixture())
    test.assert_eq(builder_state.showing(back), "field")
}
