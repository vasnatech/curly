// `curly gui`'s pure half: what a gesture does to the window, asserted rather than squinted at.
//
// **This file is the reason `gui/state.zm` is separate from `gui/app.zm`**, the same split
// `tui/` already has: `app.zm` opens a window, reads a font and talks to the network, while
// `state.zm` takes a state and an input and answers a new state. Every case below is one the
// window was driven by hand to find, and none of them would have been caught twice.
//
// `step` needs a laid-out tree to route an input by, so each test lays the real `view` out at a
// window-sized box with the metrics below. That is not a stub for the layout -- it *is* the
// layout, with a stub for the font.
use a11y
use controls
use core/exec as exec
use core/saved
use core/saved.Collection
use core/saved.Folder
use core/saved.SavedRequest
use core/storage
use focus
use fs
use geom
use gui/state
use gui/state.Loaded
use gui/state.State
use gui/state.opening_state
use gui/state.sidebar_of
use http
use image
use paint
use shape
use test
use theme
use uuid.uuid_new
use widget

fn metrics() -> widget.Metrics {
    return widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 7.0 },
        fn(size: float) -> float { return size * 1.4 }
    )
}

fn style() -> controls.Style {
    return with theme.plain() { collapsed_mark: ">", expanded_mark: "v" }
}

// The resting frame these tests draw in.
fn frame() -> controls.Frame {
    return controls.frame_of(style(), metrics())
}

val window_box = geom.rect_of(0.0, 0.0, 1100.0, 700.0)

fn request_of(name: string, url: string) -> SavedRequest {
    return SavedRequest {
        id: uuid_new(),
        name: name,
        method: "GET",
        url: url,
        query_params: [],
        headers: [saved_pair("Accept", "application/json")],
        body: None,
        auth: None,
        extract: []
    }
}

fn saved_pair(name: string, value: string) -> saved.KvPair {
    return saved.kv_pair_of(name, value)
}

// One collection with two requests and a folder holding a third, which is the shape that made the
// sidebar a tree in the first place.
fn demo() -> [Loaded] {
    return [Loaded {
        name: "demo",
        collection: Collection {
            id: uuid_new(),
            name: "demo",
            folders: [Folder {
                id: uuid_new(),
                name: "local",
                folders: [],
                requests: [request_of("index", "http://127.0.0.1/index")]
            }],
            requests: [
                request_of("hello", "http://127.0.0.1/hello"),
                request_of("goodbye", "http://127.0.0.1/goodbye")
            ]
        }
    }]
}

fn opened() -> State {
    return opening_state(demo(), ["(global)"])
}

fn laid_of(s: State) -> widget.Laid {
    return widget.layout(state.view(s, frame()), window_box, metrics())
}

fn acted(s: State, input: controls.Input) -> state.Step {
    return state.step(s, input, laid_of(s), frame())
}

fn pressed(s: State, name: string, dx: float, dy: float) -> state.Step {
    val box = state.bounds_of(laid_of(s), name)
    return acted(s, controls.Input.Press(geom.point_of(box.x + dx, box.y + dy)))
}

fn typed(s: State, k: controls.Key) -> state.Step {
    return acted(s, controls.Input.KeyDown(controls.keystroke_of(k)))
}

fn shown_url(s: State) -> string {
    return s.url.editor.text
}

// ---- the sidebar

#[test]
fn a_collection_a_folder_and_three_requests_become_five_rows() {
    val side = sidebar_of(demo(), "")
    test.assert_len(5, side.tree.rows)
    test.assert_len(3, side.items)
    // The collection row and the folder row map to no request; the three leaves do.
    test.assert_eq(side.item_of[0], 0 - 1)
    test.assert_eq(side.key_of[0], "demo")
    test.assert_eq(side.key_of[3], "demo/local/")
    test.assert_eq(side.items[2].path, "local/index")
}

// **The window opens showing a request, not a blank form.** The first *row* is a collection, so
// opening on the selection would show nothing -- it takes the first item instead.
#[test]
fn the_window_opens_on_the_first_request() {
    test.assert_eq(shown_url(opened()), "http://127.0.0.1/hello")
}

// A press on a leaf loads it. The row is 20 points tall and `hello` is the second row.
#[test]
fn pressing_a_request_row_loads_that_request() {
    val step = pressed(opened(), "requests", 60.0, 30.0)
    test.assert_eq(shown_url(step.state), "http://127.0.0.1/hello")
    val next = pressed(step.state, "requests", 60.0, 50.0)
    test.assert_eq(shown_url(next.state), "http://127.0.0.1/goodbye")
}

// **A folder is not a request, so landing on one leaves the editors alone.** A user opening a
// folder on the way to something has not asked to lose what they were looking at -- and blanking
// the form would be the obvious implementation.
#[test]
fn landing_on_a_folder_leaves_the_editors_alone() {
    val on_goodbye = pressed(opened(), "requests", 60.0, 50.0).state
    test.assert_eq(shown_url(on_goodbye), "http://127.0.0.1/goodbye")
    val on_folder = pressed(on_goodbye, "requests", 60.0, 70.0)
    test.assert_eq(shown_url(on_folder.state), "http://127.0.0.1/goodbye")
}

// A press on a branch's mark opens and closes it rather than selecting it.
#[test]
fn pressing_the_mark_collapses_the_collection() {
    val shut = pressed(opened(), "requests", 8.0, 10.0)
    test.assert_len(1, controls.visible_rows(shut.state.sidebar.tree))
    val open_again = pressed(shut.state, "requests", 8.0, 10.0)
    test.assert_len(5, controls.visible_rows(open_again.state.sidebar.tree))
}

// ---- what the window was driven by hand to find

fn exchange(at: string, url: string, body: string) -> storage.HistoryEntry {
    return storage.HistoryEntry {
        sent_at: at,
        method: "GET",
        url: url,
        request_headers: [],
        request_body: None,
        request_body_truncated: false,
        request_auth_kind: None,
        status: 200,
        elapsed_ms: 3,
        response_headers: [],
        response_body: body,
        response_body_truncated: false
    }
}

// **The entries have to be real.** The first version of these two tests left `past` empty, and
// the handler skips everything when there is nothing behind the highlighted row -- so both passed
// against the defect they exist for. Mutation is what said so: putting the old behaviour back
// changed nothing.
fn browsing_history() -> State {
    val entries = [
        exchange("2026-11-12T10:00:00Z", "http://a.test/one", "first"),
        exchange("2026-11-12T11:00:00Z", "http://b.test/two", "second")
    ]
    val showing = with opened() {
        past: entries,
        history: state.history_table(entries),
        // **Focused on the list, because a key goes where the focus is.** Without this the Down
        // below is routed to the request tree and both tests pass for the wrong reason.
        focused: "history"
    }
    return state.show_pane(showing, state.Pane.History)
}

// **Moving in the history list loads the exchange; only Enter leaves the list.** Switching the
// pane on a move threw a keyboard user out of the list on their first Down, which made history
// unreachable without a mouse. `controls.table_input` reports `moved` for an arrow key *and* for a
// mouse press, so the two cannot be told apart by the kind of input.
#[test]
fn arrowing_the_history_list_does_not_leave_it() {
    val moved = typed(browsing_history(), controls.Key.Down)
    test.assert(state.Pane.is_History(state.showing(moved.state)))
    // It still loaded what it landed on, which is the half that must not be lost in fixing the
    // other one.
    test.assert(contains(moved.state.response.editor.text, "second"))
}

// **The history pane is a table, and its cells are the fields rather than one run-together
// line.** The old shape put a status, a method, a URL and a time in one string with double spaces
// standing in for columns, so this is what says that is gone: five cells, and the status on its
// own.
#[test]
fn a_history_row_is_cells_and_not_a_sentence() {
    val h = browsing_history().history
    test.assert_len(5, h.columns)
    test.assert_eq(controls.cell_at(h, 0, 1), "GET")
    test.assert_eq(controls.cell_at(h, 0, 2), "http://a.test/one")
    // A reader hears them as fields, in the columns' order.
    test.assert(contains(controls.row_label(h, 0), "GET, http://a.test/one"))
}

// Enter is what leaves the list, and it shows the exchange the user was on.
#[test]
fn enter_on_a_history_row_shows_the_response() {
    val chosen = typed(browsing_history(), controls.Key.Enter)
    test.assert(state.Pane.is_Response(state.showing(chosen.state)))
    test.assert(contains(chosen.state.response.editor.text, "first"))
}

// **A press anywhere else closes an open dropdown.** A popup is a layer that lets clicks through,
// so the press is routed to whatever is underneath and the menu never sees it -- it cannot answer
// an input it is not handed. Invisible while the window had one dropdown; with two, opening one
// left the other hanging open over it.
#[test]
fn a_press_elsewhere_closes_an_open_dropdown() {
    val s = opened()
    val opened_menu = with s { env: with s.env { open: true } }
    test.assert(opened_menu.env.open)
    val away = pressed(opened_menu, "url", 10.0, 10.0)
    test.assert_false(away.state.env.open)
}

// ...and a press on the dropdown itself does not.
#[test]
fn a_press_on_the_open_dropdown_leaves_it_open() {
    val s = opened()
    val opened_menu = with s { env: with s.env { open: true } }
    val on_items = state.step(
        opened_menu,
        controls.Input.Press(geom.point_of(0.0 - 50.0, 0.0 - 50.0)),
        laid_of(opened_menu),
        frame()
    )
    // A press that reaches no control at all must not be read as "somewhere else" either.
    test.assert_false(on_items.state.env.open)
}

// ---- the editors

// **A row with no name is not a header**, which is how one is deleted without the `x`.
#[test]
fn a_blank_row_is_not_a_header() {
    val s = opened()
    test.assert_len(1, state.pairs_of(s.headers))
    test.assert_eq(state.pairs_of(s.headers)[0].name, "Accept")
}

// **A field with no editor survives a save; a field with one is taken from it.** The first half
// is what makes it safe for this window not to have an editor for everything -- `id` and `name`
// have none and a save must not invent a new identity. The second is the newer half, and the two
// are easy to get backwards: this test was first written asserting that `query_params` survived,
// which stopped being true the day they got a tab of their own.
#[test]
fn a_save_keeps_what_has_no_editor_and_takes_what_has_one() {
    val source = with request_of("x", "http://example.test/x") {
        query_params: [saved_pair("limit", "50")]
    }
    val built = state.edited_request_from(opened(), source)
    test.assert_eq(built.id, source.id)
    test.assert_eq(built.name, "x")
    // The editors are the opening ones, which hold no query parameters -- so the saved ones go,
    // which is what a user emptying the Query tab means.
    test.assert_len(0, built.query_params)

    // ...and with the tab filled, what is in it is what is written.
    val s = opened()
    val filled = with s { query: state.pair_table("query", "Query", "+ parameter", [saved_pair("page", "2")]) }
    val second = state.edited_request_from(filled, source)
    test.assert_len(1, second.query_params)
    test.assert_eq(second.query_params[0].name, "page")
}

// **A reload matches rows by path, not by index.** Saving under a new name adds a row and moves
// every index below it, so carrying the numbers over would reopen the wrong folders and select a
// different request.
#[test]
fn a_reload_keeps_the_shape_by_path_and_not_by_index() {
    val before = sidebar_of(demo(), "")
    val shut = controls.tree_input(
        with before.tree { selected: 4 },
        controls.Input.Press(geom.point_of(24.0, 70.0)),
        geom.rect_of(0.0, 0.0, 280.0, 400.0),
        frame()
    )
    val collapsed = with before { tree: shut.tree }
    test.assert_false(collapsed.tree.rows[3].expanded)

    // A request added at the top moves every index below it by one.
    val grown = sidebar_of([Loaded {
        name: "demo",
        collection: Collection {
            id: uuid_new(),
            name: "demo",
            folders: [Folder {
                id: uuid_new(),
                name: "local",
                folders: [],
                requests: [request_of("index", "http://127.0.0.1/index")]
            }],
            requests: [
                request_of("aardvark", "http://127.0.0.1/aardvark"),
                request_of("hello", "http://127.0.0.1/hello"),
                request_of("goodbye", "http://127.0.0.1/goodbye")
            ]
        }
    }], "")
    val kept = state.relaid(collapsed, grown)
    // The folder is still shut though it has moved down a row, and the selection still names the
    // same thing it named before.
    test.assert_eq(kept.key_of[4], "demo/local/")
    test.assert_false(kept.tree.rows[4].expanded)
    test.assert_eq(kept.key_of[kept.tree.selected], collapsed.key_of[collapsed.tree.selected])
}

// ---- the divider between the panes

// **The sidebar is draggable, which it was not for sixteen tasks.** It was
// `widget.fixed_of(sidebar_width, ...)`; it is a split pane now, and this is the only test that
// says the two halves of it are wired together -- `lib/ui` has its own tests for the arithmetic,
// and what this one proves is that the drag reaches the window's state and the window lays itself
// out from it.
#[test]
fn dragging_the_divider_resizes_the_sidebar() {
    val s = opened()
    val before = state.bounds_of(laid_of(s), "requests").width
    val box = state.bounds_of(laid_of(s), "layout/divider")
    // Pressed three points into the divider, so the grab offset is not zero -- see
    // `controls_test.zm`, where pressing exactly on an edge is what makes a jumping divider pass.
    val held = pressed(s, "layout/divider", 3.0, 100.0)
    val dragged = acted(held.state, controls.Input.Move(geom.point_of(box.x + 103.0, 100.0)))
    test.assert_eq(state.bounds_of(laid_of(dragged.state), "requests").width, before + 100.0)
    // And the request pane gave up exactly what the sidebar took.
    test.assert_eq(
        state.bounds_of(laid_of(dragged.state), "url").x,
        state.bounds_of(laid_of(s), "url").x + 100.0
    )
}

// **The divider stops rather than squeezing the toolbar to nothing.** `main_min` is the bar's own
// width, so a drag to the right edge of the window leaves the URL field a stub instead of a
// negative box -- which is the one failure mode a minimum exists for.
#[test]
fn the_divider_stops_before_the_toolbar_runs_out_of_room() {
    val s = opened()
    val held = pressed(s, "layout/divider", 3.0, 100.0)
    val shoved = acted(held.state, controls.Input.Move(geom.point_of(2000.0, 100.0)))
    val url = state.bounds_of(laid_of(shoved.state), "url")
    test.assert(url.width > 0.0)
    test.assert(state.bounds_of(laid_of(shoved.state), "requests").width > 0.0)
}

// ---- the keyboard

// Tab moves the focus and reaches no control, which is why `step` takes it before routing.
#[test]
fn tab_moves_the_focus_without_reaching_a_control() {
    val s = opened()
    val moved = typed(s, controls.Key.Tab)
    test.assert(moved.state.focused != s.focused)
    test.assert_false(moved.send)
    test.assert_false(moved.save)
}

// Every control the window draws is reachable by Tab, which is the only check that a new editor
// has been wired into the focus order rather than merely drawn.
#[test]
fn every_editor_is_reachable_by_tab() {
    val s = opened()
    val names = mutable_array_new<string>()
    for one in focus.controls(laid_of(s)) {
        push(names, one.name)
    }
    val reachable = snapshot(names)
    for wanted in ["requests", "method", "url", "send", "save", "save-as", "editors", "panes"] {
        test.assert(contains(reachable, wanted))
    }
}

// ---- the filter

fn filtered(query: string) -> state.Sidebar {
    return sidebar_of(demo(), query)
}

fn rows_of(side: state.Sidebar) -> string {
    val out = mutable_array_new<string>()
    for row in side.tree.rows {
        push(out, row.label)
    }
    return join(separator: " ", pieces: snapshot(out))
}

#[test]
fn an_empty_query_keeps_everything() {
    test.assert_eq(rows_of(filtered("")), "demo hello goodbye local index")
    test.assert_eq(rows_of(filtered("   ")), "demo hello goodbye local index")
}

// **A match keeps the folders above it**, or what is left is a handful of orphans at depths that
// mean nothing.
#[test]
fn a_match_keeps_the_folders_above_it() {
    test.assert_eq(rows_of(filtered("index")), "demo local index")
}

// **A folder's name matches its contents**, because a request's key begins with the folder it sits
// in -- which is why this matches on the path and not on the row's own label.
#[test]
fn naming_a_folder_shows_what_is_in_it() {
    test.assert_eq(rows_of(filtered("local")), "demo local index")
}

#[test]
fn naming_the_collection_shows_all_of_it() {
    test.assert_eq(rows_of(filtered("demo")), "demo hello goodbye local index")
}

#[test]
fn the_query_ignores_capitals() {
    test.assert_eq(rows_of(filtered("INDEX")), rows_of(filtered("index")))
}

// **A collection or folder with nothing left in it goes too**, rather than standing as an empty
// heading over nothing -- which is what a filter that only dropped leaves would leave behind.
#[test]
fn a_branch_with_nothing_left_goes_with_its_rows() {
    test.assert_eq(rows_of(filtered("hello")), "demo hello")
    test.assert_eq(rows_of(filtered("nothing-matches-this")), "")
}

// The three arrays stay in step, which is the thing a filter in place would get wrong.
#[test]
fn the_rows_items_and_keys_still_agree() {
    val side = filtered("index")
    test.assert_len(3, side.tree.rows)
    test.assert_len(3, side.item_of)
    test.assert_len(3, side.key_of)
    test.assert_len(1, side.items)
    test.assert_eq(side.item_of[0], 0 - 1)
    test.assert_eq(side.item_of[1], 0 - 1)
    test.assert_eq(side.item_of[2], 0)
    test.assert_eq(side.items[side.item_of[2]].path, "local/index")
}

// Typing in the box narrows the tree, and `step` is what connects the two.
#[test]
fn typing_in_the_filter_narrows_the_sidebar() {
    val s = with opened() { focused: "filter" }
    val typed = acted(s, controls.Input.Text("index"))
    test.assert_eq(rows_of(typed.state.sidebar), "demo local index")
    test.assert_eq(typed.state.filter.editor.text, "index")
}

// **There is no test here for the `!changed` guard, and that is deliberate.** A caret move
// rebuilding the sidebar produces exactly the same sidebar, so nothing an assertion can reach
// tells the two apart -- a test for it passes whether the guard is there or not, which mutation
// said out loud: removing it failed nothing. It is a performance choice and belongs in a
// measurement, not in a gate that only looks like one.

// ------------------------------------------------- the window's geometry (2026-11-13)

// Every named control's bounds, in every state the window can be in, against a committed baseline.
//
// **This exists because the rest of this file cannot see a control move.** Every other test here
// finds a control by `bounds_of(name)` and presses inside it, so it passes wherever that control
// is -- blind to movement by construction. A change that shifted the pane switcher twelve points
// up left all 263 of them green, and was caught only by dumping coordinates and diffing them by
// hand. This is that diff, kept.
//
// A failure here is a layout change: either it was meant, and the baseline moves in the same
// commit, or it was not, and this is the only thing in the suite that would have said so.
//
// When it was meant, the test leaves `window_geometry.actual.txt` beside the baseline and names
// it, so the update is `mv` and the review is a diff. Reporting one differing line at a time and
// asking for a 250-line file to be retyped is how a baseline stops being maintained and starts
// being deleted.
fn dump_into(l: widget.Laid, out: MutableArray<string>) {
    if Control(c) = l.widget {
        push(out, format(
            "GEOM {} x={} y={} w={} h={}",
            c.name,
            str(l.bounds.x as int),
            str(l.bounds.y as int),
            str(l.bounds.width as int),
            str(l.bounds.height as int)
        ))
    }
    for child in l.children {
        dump_into(child, out)
    }
}

fn geometry_lines() -> [string] {
    val out = mutable_array_new<string>()
    // Every editor tab, because each draws a different editor and the default shows one of five.
    for which in 0..5 {
        push(out, format("-- editor {} --", str(which)))
        dump_into(laid_of(with opened() { editors: with opened().editors { selected: which } }), out)
    }
    // Basic authorization, the only state that draws all three of the auth panel's rows.
    push(out, "-- auth basic --")
    val on_auth = with opened() { editors: with opened().editors { selected: 2 } }
    val basic = with on_auth {
        auth: with on_auth.auth {
            kind: with on_auth.auth.kind { items: with on_auth.auth.kind.items { selected: 1 } }
        }
    }
    dump_into(laid_of(basic), out)
    // The Save As dialog, both halves: its error line is conditional, and the panel is fixed at
    // the size it has with one showing so that it does not jump when you mistype.
    val naming = state.Naming {
        collection: controls.entry_of("save-collection", "Collection", "demo"),
        path: controls.entry_of("save-path", "Name", "a/request"),
        confirm: controls.button_of("save-confirm", "Save"),
        cancel: controls.button_of("save-cancel", "Cancel"),
        error: ""
    }
    push(out, "-- dialog --")
    dump_into(laid_of(with opened() { naming: Option<state.Naming>.Some(naming) }), out)
    push(out, "-- dialog with an error --")
    val failing = with naming { error: "that name is taken" }
    dump_into(laid_of(with opened() { naming: Option<state.Naming>.Some(failing) }), out)
    return snapshot(out)
}

#[test]
fn the_window_lays_out_where_the_baseline_says() {
    val found = switch fs.resolve("window_geometry.txt") {
        Some(path) { path }
        None {
            test.fail("window_geometry.txt is not on ZIMAN_RESOURCE_PATH")
            ""
        }
    }
    val baseline = switch fs.read_text(found) {
        Ok(t) { t }
        Err(why) {
            test.fail(format("window_geometry.txt: {}", why))
            ""
        }
    }
    val wanted = lines(trim(baseline))
    val got = geometry_lines()
    var i = 0
    for line in got {
        if i >= len(wanted) {
            report(found, got, format(
                "line {}: {} -- the baseline ends at line {}",
                str(i + 1),
                line,
                str(len(wanted))
            ))
            return
        }
        if line != wanted[i] {
            report(found, got, format(
                "line {}: {} -- baseline says {}",
                str(i + 1),
                line,
                wanted[i]
            ))
            return
        }
        i = i + 1
    }
    if len(wanted) > len(got) {
        report(found, got, format(
            "the dump ends at line {}, and the baseline says {}",
            str(len(got)),
            wanted[len(got)]
        ))
    }
}

// Writes what was actually laid out next to the baseline, then fails with the first difference.
// The write is best-effort: a read-only checkout still gets the difference, just not the file.
fn report(baseline_path: string, got: [string], why: string) {
    val out = mutable_string_new()
    for line in got {
        append(out, line, "\n")
    }
    val beside = fs.path_join(fs.parent_dir(baseline_path), "window_geometry.actual.txt")
    val note = switch fs.write_bytes(beside, to_bytes(snapshot(out))) {
        Ok(_) { format(" (what was laid out is in {})", beside) }
        Err(_) { "" }
    }
    test.fail(concat(why, note))
}

// ------------------------------------------------- an input method reaching a field (2026-11-13)

// **A composition is not a `controls.Input` and so cannot go through `step`.** `lib/ui` refuses to
// make it one on purpose: it is not routed by what is under the pointer or by a focus that falls
// back, it belongs to the field holding the input-method context and nothing else. So it arrives
// through its own three functions, and these are the cases that say the dispatch behind them
// reaches the same fields `step` does.

fn composing_in(name: string, text: string) -> State {
    return state.composing(with opened() { focused: name }, text, len(text), 0, 0)
}

fn shown_in(e: controls.Entry) -> string {
    return controls.shown_text(e)
}

// The pre-edit shows and the document does not have it: that split is the whole of what a
// composition is, and a field that put it in the editor would save a half-typed word.
#[test]
fn a_composition_shows_without_entering_the_document() {
    val s = composing_in("url", "かな")
    test.assert_eq(shown_in(s.url), "http://127.0.0.1/helloかな")
    test.assert_eq(s.url.editor.text, "http://127.0.0.1/hello")
    test.assert(Option.is_Some(s.url.preedit))
}

// **The method's text, not the pre-edit's.** A conversion commits what was chosen, which is
// allowed to be neither what was typed nor what was last shown -- committing the pre-edit is the
// bug that makes a Japanese field insert romaji.
#[test]
fn a_commit_inserts_what_the_method_chose() {
    val s = state.committed(composing_in("url", "kana"), "仮名")
    test.assert_eq(s.url.editor.text, "http://127.0.0.1/hello仮名")
    test.assert(Option.is_None(s.url.preedit))
}

// Abandoning takes the pre-edit away without inserting anything, which is what losing the focus
// mid-word has to mean.
#[test]
fn a_dropped_composition_inserts_nothing() {
    val s = state.composition_dropped(composing_in("url", "かな"))
    test.assert_eq(s.url.editor.text, "http://127.0.0.1/hello")
    test.assert_eq(shown_in(s.url), "http://127.0.0.1/hello")
    test.assert(Option.is_None(s.url.preedit))
}

// Every field, not only the two obvious ones: a table cell is where a header value is typed, and
// a dispatch that stopped at the named fields would compose into the URL instead.
#[test]
fn a_composition_reaches_a_table_cell() {
    val s = composing_in("header0value", "かな")
    test.assert_eq(shown_in(state.pair_value_of(s.headers, 0)), "application/jsonかな")
    // ...and the URL, which is not focused, is untouched.
    test.assert_eq(shown_in(s.url), "http://127.0.0.1/hello")
}

// **A dialog takes the whole window**, so a composition cannot reach a field behind it -- the same
// rule `step` follows by handling the dialog before anything else.
#[test]
fn a_dialog_takes_the_composition() {
    val naming = state.Naming {
        collection: controls.entry_of("save-collection", "Collection", "demo"),
        path: controls.entry_of("save-path", "Name", "a/"),
        confirm: controls.button_of("save-confirm", "Save"),
        cancel: controls.button_of("save-cancel", "Cancel"),
        error: ""
    }
    val open = with opened() { naming: Option<state.Naming>.Some(naming), focused: "save-path" }
    val typed = state.composing(open, "かな", 2, 0, 0)
    switch typed.naming {
        Some(n) { test.assert_eq(shown_in(n.path), "a/かな") }
        None { test.fail("the dialog closed") }
    }
    // And a composition aimed at a field behind the dialog reaches nothing at all.
    val behind = state.composing(with open { focused: "url" }, "かな", 2, 0, 0)
    test.assert_eq(shown_in(behind.url), "http://127.0.0.1/hello")
}

// The focus is on a button, which cannot compose. Nothing happens, and in particular the text does
// not land in the last field that could take it.
//
// **The method is a picker since 2026-11-15 and so cannot take a composition at all** -- it left
// `with_focused_entry` with its `controls.Entry`. That makes this assertion weaker than it was and
// the guarantee behind it stronger: the method used to be a text field that a stray composition
// could have reached, and now there is no route to it even if the dispatch were wrong.
#[test]
fn a_composition_with_the_focus_on_a_button_changes_nothing() {
    val s = state.composing(with opened() { focused: "send" }, "かな", 2, 0, 0)
    test.assert_eq(shown_in(s.url), "http://127.0.0.1/hello")
    test.assert_eq(state.method_text(s.method), "GET")
}

// The marked run is the part being converted, which a method moves as the user picks among
// candidates. It is carried through rather than dropped, because it is what the field draws
// differently.
#[test]
fn the_marked_run_is_carried_to_the_field() {
    val s = state.composing(with opened() { focused: "url" }, "かなもじ", 4, 0, 2)
    switch s.url.preedit {
        Some(p) {
            test.assert_eq(p.highlight_start, 0)
            test.assert_eq(p.highlight_end, 2)
            test.assert_eq(p.caret, 4)
        }
        None { test.fail("no composition") }
    }
}

// ------------------------------------------------- the desktop's icons (2026-11-14)

// **The window asks the user's icon theme for `document-save-symbolic` and the rest**, and these
// cases are about what that does to the buttons rather than about the lookup, which `icons`' own
// tests cover against a theme built in a temporary directory.
//
// The icon here is built by hand, so **nothing in this file touches the filesystem or depends on
// the machine having a theme**: `opening_state` opens with `no_icons()` for exactly that reason,
// which is also why the geometry baseline above did not move when icons arrived.
fn an_icon(says: string) -> widget.Icon {
    val b = shape.path_builder()
    shape.move_to(b, geom.point_of(0.2, 0.2))
    shape.line_to(b, geom.point_of(0.8, 0.8))
    return widget.icon_of(shape.built(b, shape.Winding.NonZero), says)
}

fn all_icons() -> state.Icons {
    return state.Icons {
        send: Option<widget.Icon>.Some(an_icon("send")),
        save: Option<widget.Icon>.Some(an_icon("save")),
        save_as: Option<widget.Icon>.Some(an_icon("save as")),
        add: Option<widget.Icon>.Some(an_icon("add")),
        remove: Option<widget.Icon>.Some(an_icon("remove")),
        close: Option<widget.Icon>.Some(an_icon("close"))
    }
}

// How many glyph runs a laid-out tree draws whose text is exactly this, which is how a label is
// read back without a painter: the words are in the tree, and an icon is not a word.
fn says_count(l: widget.Laid, text: string) -> int {
    var found = 0
    if Text(it) = l.widget {
        if it.text == text {
            found = 1
        }
    }
    for child in l.children {
        found = found + says_count(child, text)
    }
    return found
}

#[test]
fn an_add_buttons_plus_becomes_the_icon() {
    // `+ header` draws its plus as *text*, which is a drawing made of letters. With an icon beside
    // the word the plus says the same thing twice, so the words shorten to the noun.
    val plain = laid_of(opened())
    test.assert_eq(1, says_count(plain, "+ header"))
    test.assert_eq(0, says_count(plain, "header"))
    val themed = laid_of(with opened() { icons: all_icons() })
    test.assert_eq(0, says_count(themed, "+ header"))
    test.assert_eq(1, says_count(themed, "header"))
}

#[test]
fn a_rows_remove_button_becomes_icon_only() {
    // The `x` was the other text-as-drawing. An icon-only button announces itself by the icon's
    // name, which is what `controls.announced_name` is for.
    val plain = laid_of(opened())
    test.assert(says_count(plain, "x") > 0)
    val themed = laid_of(with opened() { icons: all_icons() })
    test.assert_eq(0, says_count(themed, "x"))
}

#[test]
fn a_toolbar_button_keeps_its_words() {
    // Send, Save and Save As are named commands rather than glyphs: the icon goes *beside* the
    // word, which is what `widget.Icon`'s leading side is for.
    val themed = laid_of(with opened() { icons: all_icons() })
    test.assert_eq(1, says_count(themed, "Send"))
    test.assert_eq(1, says_count(themed, "Save"))
    test.assert_eq(1, says_count(themed, "Save As"))
}

#[test]
fn no_theme_is_the_window_that_was_there_before() {
    // **The degradation path, asserted rather than assumed.** A machine with no icon theme, or a
    // theme missing these names, gets `no_icons()` -- and then every label is exactly what it was,
    // which is the claim that lets `desktop_icons` fail silently in `run`.
    val plain = laid_of(opened())
    test.assert_eq(1, says_count(plain, "+ header"))
    test.assert_eq(1, says_count(plain, "Send"))
    test.assert(says_count(plain, "x") > 0)
}

#[test]
fn the_icons_reach_the_tree_as_drawings() {
    // **The icon is a drawn path in the tree**, which is the consequence to assert: the send
    // button's own box cannot say so, because the design file gives it a fixed width
    // (`fixed_of(field_width, ...)`) and an icon inside a fixed box takes room from the label
    // rather than from the window.
    val plain = drawings_in(laid_of(opened()))
    val themed = drawings_in(laid_of(with opened() { icons: all_icons() }))
    // Send, Save, Save As, the header table's add, and one remove per row.
    test.assert(themed > plain + 4)
}

// Drawn paths in a laid-out tree. An icon from a theme is one of these; a glyph icon would be text.
fn drawings_in(l: widget.Laid) -> int {
    var found = 0
    if Drawing(_) = l.widget {
        found = 1
    }
    for child in l.children {
        found = found + drawings_in(child)
    }
    return found
}

#[test]
fn every_rows_remove_button_says_which_row() {
    // **An icon-only button is announced by its icon's name**, so three rows that all said
    // "remove" would be exactly as useless as the three `x`es they replaced -- and worse, because
    // nothing on screen shows it. The first row of the demo collection's request carries an
    // `Accept` header; the blank rows below it fall back to their position.
    val themed = laid_of(with opened() { icons: all_icons() })
    val tree = a11y.tree_of(themed, "curly", "")
    val said = mutable_array_new<string>()
    for node in a11y.reachable(tree) {
        if starts_with(node.name, "remove") {
            push(said, node.name)
        }
    }
    val names = snapshot(said)
    test.assert(len(names) > 1)
    // No two rows announce the same thing, which is the whole claim.
    var i = 0
    while i < len(names) {
        var j = i + 1
        while j < len(names) {
            test.assert_ne(names[i], names[j])
            j = j + 1
        }
        i = i + 1
    }
    // And a row with a header typed into it is named for the header rather than its position.
    test.assert_contains(names, "remove Accept")
    test.assert_contains(names, "remove Header 2")
}

// ------------------------------------------- a response that is a picture (2026-11-14)

// **A PNG body is shown as a picture rather than as its bytes**, which is what `widget.Picture`
// made possible. The cases are about which responses become one: the decode itself is `image`'s.
fn png_response(kind: string, body: [byte]) -> exec.ResponseSummary {
    return exec.ResponseSummary {
        status: 200,
        headers: [http.Header { name: "Content-Type", value: kind }],
        body: "",
        body_bytes: body,
        elapsed_millis: 3
    }
}

fn a_png(width: int, height: int) -> [byte] {
    val canvas = switch image.canvas(width, height, image.Pixels.Rgba8) {
        Ok(c) { c }
        Err(why) {
            test.fail(why)
            return []
        }
    }
    var x = 0
    while x < width {
        var y = 0
        while y < height {
            if Err(why) = image.set(canvas, x, y, paint.rgb(0.2, 0.6, 0.9)) {
                test.fail(why)
            }
            y = y + 1
        }
        x = x + 1
    }
    return image.encode_png(image.snapshot_image(canvas))
}

#[test]
fn a_png_body_becomes_a_preview() {
    val preview = state.preview_of(png_response("image/png", a_png(40, 20)))
    test.assert(switch preview {
        Some(it) { true }
        None { false }
    })
    switch preview {
        Some(it) {
            test.assert_near(40.0, it.width, 0.001)
            test.assert_near(20.0, it.height, 0.001)
            // The alt text is what a reader is told, and it says what the picture is rather than
            // that there is one.
            test.assert_contains(it.alt, "40 by 20")
        }
        None { unit }
    }
}

#[test]
fn anything_else_stays_text() {
    // A JSON body, the ordinary case.
    test.assert(absent(state.preview_of(png_response("application/json", to_bytes("{}")))))
    // A body that claims to be a PNG and is not: the decode fails and the text pane shows the
    // headers, which is more use than refusing to show the response at all.
    test.assert(absent(state.preview_of(png_response("image/png", to_bytes("not a png")))))
    // A JPEG body that is really a PNG: the content type picks the decoder, and the decoder
    // refuses what it was handed rather than guessing from the bytes.
    test.assert(absent(state.preview_of(png_response("image/jpeg", a_png(4, 4)))))
    // And a real JPEG is shown, which is what the decoder landing today bought.
    test.assert_false(absent(state.preview_of(png_response("image/jpeg", a_jpeg()))))
    // The header's case and its parameters do not matter.
    test.assert_false(absent(state.preview_of(png_response("IMAGE/PNG; charset=binary", a_png(4, 4)))))
}

// A real baseline JPEG, resolved through `ZIMAN_RESOURCE_PATH` like every other fixture here.
//
// **A copy of ziman's own, rather than a path into its repository**: a test that read a file out of
// a sibling checkout would pass on this machine and nowhere else, and curly is a separate project
// that happens to live next door.
fn a_jpeg() -> [byte] {
    val path = switch fs.resolve("sample.jpg") {
        Some(found) { found }
        None {
            test.fail("sample.jpg is not on ZIMAN_RESOURCE_PATH")
            return []
        }
    }
    return switch fs.read_bytes(path) {
        Ok(data) { data }
        Err(e) {
            test.fail(fs.fs_error_message(e))
            []
        }
    }
}

fn absent(p: Option<state.Preview>) -> bool {
    return switch p {
        Some(_) { false }
        None { true }
    }
}

#[test]
fn the_response_pane_draws_the_picture() {
    // The view shows one where there is one, and the text entry where there is not.
    val plain = laid_of(opened())
    test.assert_eq(0, pictures_in(plain))
    val showing = switch state.preview_of(png_response("image/png", a_png(40, 20))) {
        Some(it) { with opened() { preview: Option<state.Preview>.Some(it) } }
        None {
            test.fail("no preview")
            opened()
        }
    }
    test.assert_eq(1, pictures_in(laid_of(showing)))
    // **The handle is 0 at both ends or the window draws the wrong picture.** `app.zm` registers
    // the preview as the only image in `raster.Options.images`, and the view asks for index 0;
    // nothing else in this window registers one, so the two lines are the whole wiring and this
    // pins them together.
    test.assert_eq(0, handle_of(laid_of(showing)))
}

fn handle_of(l: widget.Laid) -> int {
    if Picture(it) = l.widget {
        return it.image
    }
    for child in l.children {
        val found = handle_of(child)
        if found >= 0 {
            return found
        }
    }
    return 0 - 1
}

fn pictures_in(l: widget.Laid) -> int {
    var found = 0
    if Picture(_) = l.widget {
        found = 1
    }
    for child in l.children {
        found = found + pictures_in(child)
    }
    return found
}

// **Nothing in this window paints into no space.** `widget.measured_as_nothing` is ziman's guard
// against the trap that has cost `lib/ui` eight victims -- a node with ink to put down and no
// extent to put it in, which draws nothing, raises nothing and passes every test that does not
// look for it.
//
// This window is the second application on `lib/ui` and the one that has found most of its
// defects by being used, so it is worth holding to the same rule as the gallery.
#[test]
fn no_screen_paints_into_no_space() {
    val lost = widget.measured_as_nothing(laid_of(opened()))
    if len(lost) > 0 {
        test.fail(concat(str(len(lost)), " node(s) painted into no space"))
    }
}
