// `curly` -- the command line.
//
// **Invoked as `ziman curly.zm -- <args>`**, which `bin/curly` wraps so that nobody has to type it.
// That wrapper is a real difference from the Rust implementation rather than a detail: there the
// CLI is a single native binary, here it is a script the interpreter runs, so `os.args()` only sees
// what follows `--` (a shebang cannot help, since the kernel appends the script path *after* the
// interpreter's own arguments).
//
// **Storage is resolved once, before dispatch, except for `init`** -- which creates the very
// directory resolution looks for, so it cannot depend on a resolved one. `core/storage.resolve`
// owns the precedence; this only passes `--data-dir` in.
//
// A bare `curly` prints help. The text is this port's own: the Rust CLI's help is generated by
// clap, and reproducing clap's exact layout would be imitating a library rather than matching a
// behaviour, so `parity.sh` compares every command's *output* and not the help.
use cli/args
use cli/args.Parsed
use cli/commands/collections as collections_command
use cli/commands/env as env_command
use cli/commands/history as history_command
use cli/commands/init as init_command
use cli/commands/one_shot as one_shot_command
use cli/commands/run as run_command
use cli/commands/scenario as scenario_command
use cli/commands/session as session_command
use core/storage.Storage
use core/storage.resolve
use os

// Flags every command accepts.
val global_values = ["--data-dir"]

// A token that is not one of the subcommands is a URL, which is what puts the CLI into one-shot
// mode. Checked by name rather than by "does it look like a URL", because `curly exmaple.com`
// should be a request to a host that does not resolve, not a complaint about an unknown command.
fn is_subcommand(word: string) -> bool {
    return contains(
        ["init", "env", "collections", "scenario", "session", "history", "run", "gui"],
        word
    )
}

fn flags_for(command: string, action: string) -> [string] {
    if command == "run" {
        return concat(global_values, run_command.value_flags())
    }
    if command == "collections" {
        return concat(global_values, collections_command.value_flags())
    }
    if command == "env" && action == "import-postman" {
        return concat(global_values, ["--as"])
    }
    if command == "session" {
        return concat(global_values, ["--env"])
    }
    if command == "scenario" && action == "run" {
        return concat(global_values, ["--env", "--var"])
    }
    if command == "history" {
        return concat(global_values, ["--limit"])
    }
    return global_values
}

fn switches_for(command: string, action: string) -> [string] {
    if command == "run" {
        return run_command.switch_flags()
    }
    if command == "collections" {
        return collections_command.switch_flags()
    }
    if command == "env" && action == "set" {
        return ["--secret"]
    }
    if command == "session" && action == "clear" {
        return ["--all"]
    }
    return []
}

// Commands whose first positional is a sub-action rather than a value.
fn takes_an_action(command: string) -> bool {
    return command == "env" || command == "session" || command == "collections" || command == "scenario"
}

fn help() {
    print("curly - a curl-like HTTP client")
    print("")
    print("Usage: curly [OPTIONS] [COMMAND]")
    print("")
    print("Commands:")
    print("  init          Create a project-local ./.curly storage directory (like `git init`)")
    print("  env           Manage environments (named {{variable}} sets)")
    print("  collections   Manage collections and their saved requests")
    print("  scenario      Inspect and run multi-request scenarios")
    print("  session       Inspect or clear variables a run extracted")
    print("  history       Show recorded requests")
    print("")
    print("Options:")
    print("      --data-dir <DATA_DIR>  Where to store collections/environments/history")
    print("  -h, --help                 Print help")
}

fn main() {
    val argv = os.args()
    if len(argv) == 0 {
        help()
        return
    }
    if argv[0] == "-h" || argv[0] == "--help" || argv[0] == "help" {
        help()
        return
    }

    // **One-shot mode**: no subcommand, so the whole vector is its arguments and the URL is the
    // first positional.
    if !is_subcommand(argv[0]) {
        val parsed = switch args.parse(
            argv,
            concat(global_values, one_shot_command.value_flags()),
            one_shot_command.switch_flags()
        ) {
            Ok(p) { p }
            Err(why) {
                os.write_stderr(concat("Error: ", why, "\n"))
                os.exit(2)
                return
            }
        }
        val store = switch resolve(args.value_of(parsed, "data-dir"), os.get_env("CURLY_DATA_DIR"), cwd_or_dot()) {
            Ok(s) { s }
            Err(why) {
                os.write_stderr(concat("Error: ", why, "\n"))
                os.exit(1)
                return
            }
        }
        finish(one_shot_command.run(parsed, store))
        return
    }

    val command = argv[0]
    val after = slice(argv, 1, len(argv))
    // A sub-action is the first non-flag token, which has to be found before the flags can be
    // parsed -- `env set` and `env import-postman` do not accept the same ones.
    val action = if takes_an_action(command) { first_bare(after) } else { "" }

    val parsed = switch args.parse(after, flags_for(command, action), switches_for(command, action)) {
        Ok(p) { p }
        Err(why) {
            os.write_stderr(concat("Error: ", why, "\n"))
            os.exit(2)
            return
        }
    }
    // The sub-action is consumed; what is left is the command's own arguments.
    val rest = if takes_an_action(command) && len(parsed.positionals) > 0 {
        with parsed { positionals: slice(parsed.positionals, 1, len(parsed.positionals)) }
    } else {
        parsed
    }

    if command == "init" {
        finish(init_command.run())
        return
    }

    // **Resolved after `init` is handled and before anything else runs**, so a command that reads
    // storage cannot half-run against the wrong root.
    val store = switch resolve(args.value_of(parsed, "data-dir"), os.get_env("CURLY_DATA_DIR"), cwd_or_dot()) {
        Ok(s) { s }
        Err(why) {
            os.write_stderr(concat("Error: ", why, "\n"))
            os.exit(1)
            return
        }
    }

    if command == "env" {
        finish(env_command.run(action, rest, store))
        return
    }
    if command == "session" {
        finish(session_command.run(action, rest, store))
        return
    }
    if command == "collections" {
        finish(collections_command.run(action, rest, store))
        return
    }
    if command == "scenario" {
        finish(scenario_command.run(action, rest, store))
        return
    }
    if command == "run" {
        finish(run_command.run(rest, store))
        return
    }
    if command == "history" {
        finish(history_command.run(rest, store))
        return
    }

    os.write_stderr(concat("Error: unrecognised command: ", command, "\n"))
    os.exit(2)
}

// The first non-flag token, which is a command's sub-action. Stops at `--` for the same reason the
// parser does.
fn first_bare(argv: [string]) -> string {
    for token in argv {
        if token == "--" {
            return ""
        }
        if !starts_with(token, "-") {
            return token
        }
    }
    return ""
}

fn cwd_or_dot() -> string {
    return switch os.cwd() {
        Ok(d) { d }
        Err(_) { "." }
    }
}

// **A failure is `Error: <message>` on stderr and a non-zero status**, matching what the Rust
// CLI's `anyhow` reporting puts on its first line, so a script can tell a refusal from an empty
// result and a person reads the same sentence either way.
//
// **What is deliberately not reproduced is anyhow's `Caused by:` paragraph.** Rust appends the
// underlying `io::Error` ("No such file or directory (os error 2)") as an indented chain below the
// message. That is a presentation its error library chose; the message above it is the contract,
// and `parity.sh` compares that line. Imitating the chain's layout would be matching a Rust crate
// rather than a behaviour.
fn finish(outcome: Result<unit, string>) {
    if Err(why) = outcome {
        os.write_stderr(concat("Error: ", why, "\n"))
        os.exit(1)
    }
}
