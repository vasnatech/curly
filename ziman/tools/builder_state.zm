// The builder's pure half: a state, the window it draws, and what an input does to it.
//
// **Split from `builder.zm` for the same reason `gui/state.zm` is split from `gui/app.zm`**: this
// file opens no window, reads no font and polls no event queue, so every behaviour in it is
// reachable from `ziman test` on a machine with no display. The shell is the part that cannot be
// tested and it is kept as small as that costs.
//
// **The canvas is a second tree, laid out beside the builder's own and never merged into it.**
// That is the one design decision the rest follows from. Rendering a design file produces real
// `controls` -- a real entry, a real tree -- and putting them inside the builder's widget tree
// would put them in its tab order and hand them its keystrokes: clicking the design's filter box
// would type into it instead of selecting it. Laid out separately, the design is a picture the
// builder paints and hit-tests, and nothing it contains can take the focus.
//
// It is laid out **at the canvas box**, not at the origin and then translated, so its coordinates
// are already the window's and there is no transform anywhere -- not in the paint, not in the hit
// test, and so no pair of them to disagree.
use controls
use focus
use fs
use geom
use tools/read_design
use tools/read_design.Component
use tools/read_design.Constant
use tools/read_design.Record
use tools/render_design
use tools/render_design.Spot
use widget

val panel_width = 250.0
val inspector_width = 380.0
val gap = 8.0
val row_height = 30.0
val heading_size = 13.0
val small_size = 11.0
val source_rows = 6

pub struct State {
    path: string
    // The file as it is on disk, which is what spans index into. Re-read on every load rather
    // than tracked, because a span is a promise about bytes and a stale copy breaks it silently.
    text: string
    // **Parsed once per load, not per frame.** Every panel reads these, and curly's own window
    // measured what rebuilding per frame costs: an idle window at 66% of a core.
    components: [Component]
    constants: [Constant]
    records: [Record]
    parts: controls.List
    source: controls.Entry
    apply: controls.Button
    revert: controls.Button
    inputs: controls.List
    // What can be added. See `palette_items` for why the list is short.
    palette: controls.List
    insert: controls.Button
    remove: controls.Button
    up: controls.Button
    down: controls.Button
    picked: Option<Spot>
    status: string
    focused: string
}

// What a builder can put on a canvas, as source.
//
// **Every one of these stands on its own**, which is the whole of why the list is this short. A
// snippet is spliced into a component's body and then has to compile there, so it may not mention
// a name the component does not have: `widget.label_of("x", 12.0, style.ink)` is the obvious entry
// to want and it needs a `style` parameter, which most parts have and nothing guarantees. The
// four below name nothing but `widget`.
//
// The real palette is the file's own `pub fn` parts, and they are not here for the reason already
// recorded against the dialect: `pub` means "a part" and also means "reachable", so a palette
// keyed off it offers `mono_label` -- and a part takes arguments this cannot invent.
pub struct Snippet {
    label: string
    source: string
}

pub fn palette_items() -> [Snippet] {
    return [
        Snippet { label: "space (flexible)", source: "widget.flex()" },
        Snippet {
            label: "space (30 points)",
            source: "widget.fixed_of(0.0, 30.0, widget.flex())"
        },
        Snippet { label: "a row", source: "widget.row_of(8.0, [widget.flex()])" },
        Snippet { label: "a column", source: "widget.column_of(8.0, [widget.flex()])" }
    ]
}

fn palette_labels() -> [string] {
    val out = mutable_array_new<string>()
    for one in palette_items() {
        push(out, one.label)
    }
    return snapshot(out)
}

pub fn showing(s: State) -> string {
    if s.parts.selected < 0 || s.parts.selected >= len(s.parts.items) {
        return ""
    }
    return s.parts.items[s.parts.selected]
}

fn component_named(name: string, all: [Component]) -> Option<Component> {
    for c in all {
        if c.name == name {
            return Option<Component>.Some(c)
        }
    }
    return Option<Component>.None
}

// The root node of a component's body, parsed.
pub fn tree_of(c: Component) -> read_design.Node {
    val ts = read_design.tokens_of(c.body)
    val start = if len(ts) > 0 && ts[0].text == "return" { 1 } else { 0 }
    return read_design.expr_at(ts, start).node
}

// Every field of every struct the file declares, as the builder would list them: these are the
// screen's inputs, the things a caller has to supply, and the only part of a design file that is
// a data interface rather than a layout.
fn input_rows(records: [Record]) -> [string] {
    val out = mutable_array_new<string>()
    for r in records {
        for f in r.fields {
            push(out, format("{}.{}: {}", r.name, f.name, f.said))
        }
    }
    return snapshot(out)
}

fn part_names(all: [Component]) -> [string] {
    val out = mutable_array_new<string>()
    for c in all {
        push(out, c.name)
    }
    return snapshot(out)
}

// A state over a file's text. Takes the text rather than reading it, so a test needs no file and
// the shell can hand over what it read.
pub fn state_of(path: string, text: string) -> State {
    val all = read_design.components_of(text)
    val names = part_names(all)
    // **`screen` first when it is there.** It is the dialect's one root, and opening on an
    // arbitrary helper would show a fragment of a window and call it the window.
    var start = 0
    var i = 0
    for name in names {
        if name == "screen" {
            start = i
        }
        i = i + 1
    }
    return State {
        path: path,
        text: text,
        components: all,
        constants: read_design.constants_of(text),
        records: read_design.records_of(text),
        parts: with controls.list_of("parts", "Components", names) { selected: start },
        source: controls.text_area_of("source", "Source", "", source_rows),
        apply: controls.button_of("apply", "Apply"),
        revert: controls.button_of("revert", "Revert"),
        inputs: controls.list_of("inputs", "Inputs", input_rows(read_design.records_of(text))),
        palette: controls.list_of("palette", "Add", palette_labels()),
        insert: controls.button_of("insert", "Insert after"),
        remove: controls.button_of("remove", "Delete"),
        up: controls.button_of("up", "Up"),
        down: controls.button_of("down", "Down"),
        picked: Option<Spot>.None,
        status: format("{} component(s)", str(len(all))),
        focused: "parts"
    }
}

pub fn load(path: string) -> Result<State, string> {
    return switch fs.read_text(path) {
        Ok(text) { ok(state_of(path, text)) }
        Err(why) { err(format("{}: {}", path, why)) }
    }
}

// ------------------------------------------------- the canvas

pub struct Canvas {
    widget_: widget.Widget
    spots: [Spot]
    // What the builder could not place: a name the file uses that nothing here supplies.
    missing: [string]
}

// The component on show, rendered. **Rebuilt when the selection or the file changes and not per
// frame**: it parses a body, evaluates it and synthesises a placeholder for every input, which is
// the expensive half of this program.
pub fn canvas_of(s: State, style: controls.Style, m: widget.Metrics) -> Canvas {
    val shop = render_design.shop_of(s.constants, s.components, s.records, style, m)
    val drawn = switch component_named(showing(s), s.components) {
        Some(c) { render_design.render(c, [], shop) }
        None { render_design.Value.None }
    }
    return Canvas {
        widget_: render_design.widget_of(drawn),
        spots: snapshot(shop.spots),
        missing: snapshot(shop.missing)
    }
}

// ------------------------------------------------- the window

fn heading(text: string, style: controls.Style) -> widget.Widget {
    return widget.fixed_of(0.0, 18.0, widget.label_of(text, heading_size, style.ink))
}

fn note(text: string, style: controls.Style) -> widget.Widget {
    return widget.fixed_of(0.0, 16.0, widget.label_of(text, small_size, style.ink))
}

// What the inspector says about the selection, which is the whole of what a builder knows about
// a click: which node, in which component, and which bytes.
pub fn selection_line(s: State) -> string {
    return switch s.picked {
        Some(spot) {
            switch node_picked(s) {
                Some(node) {
                    val at = span_of(s, spot, node)
                    format(
                        "{} of {}  [{}..{}]",
                        read_design.path_text(spot.path),
                        spot.component,
                        str(at.from),
                        str(at.to)
                    )
                }
                None { format("{} of {}", read_design.path_text(spot.path), spot.component) }
            }
        }
        None { "nothing selected" }
    }
}

// The node the selection names, in the component that owns it.
pub fn node_picked(s: State) -> Option<read_design.Node> {
    return switch s.picked {
        Some(spot) {
            switch component_named(spot.component, s.components) {
                Some(owner) { read_design.node_at(tree_of(owner), spot.path) }
                None { Option<read_design.Node>.None }
            }
        }
        None { Option<read_design.Node>.None }
    }
}

fn span_of(s: State, spot: Spot, node: read_design.Node) -> read_design.Span {
    return switch component_named(spot.component, s.components) {
        Some(owner) { read_design.span_in_file(owner, node) }
        None { read_design.Span { from: 0, to: 0 } }
    }
}

pub fn view(s: State, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.row_of(gap, [
        widget.fixed_of(panel_width, 0.0, widget.column_of(gap, [
            heading("Components", style),
            widget.expand(controls.list_widget(s.parts, style))
        ])),
        // **A `flex` and not a box of its own.** The canvas is where the design is painted, and
        // the design is a separate tree: this reserves the room and names it, and nothing inside
        // it belongs to this tree.
        widget.expand(widget.column_of(gap, [
            heading("Canvas", style),
            widget.expand(widget.Widget.Group(widget.Stack {
                direction: widget.Direction.Column,
                spacing: 0.0,
                padding: widget.no_insets(),
                surface: widget.no_surface(),
                align: widget.stretched(),
                children: [widget.flex()],
                name: "canvas"
            }))
        ])),
        widget.fixed_of(inspector_width, 0.0, widget.column_of(gap, [
            heading("Selected", style),
            note(selection_line(s), style),
            widget.fixed_of(0.0, (source_rows as float) * row_height, controls.entry_widget(
                s.source,
                style,
                m
            )),
            widget.fixed_of(0.0, row_height, widget.row_of(gap, [
                controls.button_widget(s.apply, style),
                controls.button_widget(s.revert, style),
                widget.expand(widget.flex())
            ])),
            heading("Add", style),
            widget.fixed_of(0.0, (len(palette_items()) as float) * row_height, controls.list_widget(
                s.palette,
                style
            )),
            widget.fixed_of(0.0, row_height, widget.row_of(gap, [
                controls.button_widget(s.insert, style),
                controls.button_widget(s.remove, style),
                controls.button_widget(s.up, style),
                controls.button_widget(s.down, style),
                widget.expand(widget.flex())
            ])),
            heading("Inputs", style),
            widget.expand(controls.list_widget(s.inputs, style)),
            note(s.status, style)
        ]))
    ])
}

// ------------------------------------------------- where a new node would go

// A place a node could be inserted: a list in the source, and a position in it.
//
// **A position between children, which is a different question from "what is here".** Selecting
// asks which node a point is on; inserting asks which gap it is nearest, and a gap belongs to the
// list that holds the children rather than to either of them.
pub struct Slot {
    // The `List` node in the component's tree -- the `[...]` a row or column was given.
    list: read_design.Path
    component: string
    // Where in it, from 0 to the number of items.
    index: int
    // Where to draw the insertion line, in the canvas's coordinates.
    at: geom.Rect
}

// The nearest list **above** a node, and which of its items the node is inside.
//
// **It walks up, and the first version only looked one step.** A click lands on the deepest thing
// it can -- `controls.button_widget(it.go, style)` -- whose parent is the `widget.fixed_of` that
// wraps it, not the column's list. One step up finds a `Call` and gives up, so nothing inside a
// wrapped child was ever a drop target, which is every child of every container in the file.
//
// The item is the ancestor that is the list's own child, and that is what a gap sits beside:
// dropping next to a button means dropping next to the row that holds it.
fn list_holding(owner: Component, path: read_design.Path) -> Option<Slot> {
    val steps = path.steps
    val tree = tree_of(owner)
    var depth = len(steps) - 1
    while depth >= 0 {
        val up = mutable_array_new<int>()
        var i = 0
        while i < depth {
            push(up, steps[i])
            i = i + 1
        }
        val parent = read_design.Path { steps: snapshot(up) }
        val is_list = switch read_design.node_at(tree, parent) {
            Some(node) {
                switch node {
                    List(_) { true }
                    Call(_) { false }
                    Struct(_) { false }
                    Str(_) { false }
                    Num(_) { false }
                    Path(_) { false }
                }
            }
            None { false }
        }
        if is_list {
            return Option<Slot>.Some(Slot {
                list: parent,
                component: owner.name,
                index: steps[depth],
                at: geom.rect_of(0.0, 0.0, 0.0, 0.0)
            })
        }
        depth = depth - 1
    }
    return Option<Slot>.None
}

// The box a node was drawn in, found through the tag the renderer gave it. **The item's box, not
// the clicked node's**: a gap goes beside the row that holds the button, so the edge to measure
// against and the line to draw are the row's.
fn box_of_node(shown: Shown, component: string, path: read_design.Path) -> Option<geom.Rect> {
    for one in shown.spots {
        if one.component == component && same_path(one.path, path) {
            return render_design.box_of(shown.laid, one.tag)
        }
    }
    return Option<geom.Rect>.None
}

fn same_path(a: read_design.Path, b: read_design.Path) -> bool {
    if len(a.steps) != len(b.steps) {
        return false
    }
    var i = 0
    while i < len(a.steps) {
        if a.steps[i] != b.steps[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn step_into(path: read_design.Path, index: int) -> read_design.Path {
    val out = mutable_array_new<int>()
    for one in path.steps {
        push(out, one)
    }
    push(out, index)
    return read_design.Path { steps: snapshot(out) }
}

// Whether the list is laid across or down, **read from the call that owns it rather than guessed
// from a box**. The first version took the child's own aspect -- wider than tall meant a row --
// which is backwards for the usual case: a column of full-width rows is all wide children, and
// every insertion line would have been drawn vertically down their right-hand edge.
//
// A `widget.Stack` literal says so in a field; the two helpers say so in their names. A direction
// nothing states is a column, which is what `render_design` builds for a Stack that omits it.
fn list_runs_across(owner: Component, list: read_design.Path) -> bool {
    val steps = list.steps
    if len(steps) == 0 {
        return false
    }
    val up = mutable_array_new<int>()
    var i = 0
    while i < len(steps) - 1 {
        push(up, steps[i])
        i = i + 1
    }
    return switch read_design.node_at(tree_of(owner), read_design.Path { steps: snapshot(up) }) {
        Some(node) {
            switch node {
                Call(c) { c.name == "widget.row_of" }
                Struct(f) { stack_runs_across(f) }
                List(_) { false }
                Str(_) { false }
                Num(_) { false }
                Path(_) { false }
            }
        }
        None { false }
    }
}

fn stack_runs_across(f: read_design.Fields) -> bool {
    var i = 0
    for key in f.keys {
        if key == "direction" {
            return read_design.text_of(f.values[i]) == "widget.Direction.Row"
        }
        i = i + 1
    }
    return false
}

// The gap after whatever is selected, and the line to draw for it.
//
// **Taken from the selection rather than from a pointer.** This builder has no drag: you select a
// node and say where relative to it, so there is one place a new node can go and the line says
// which. A pointer-driven drop target is a different function and will want `list_holding` the
// same way this does.
pub fn slot_after_selection(s: State, shown: Shown) -> Option<Slot> {
    val spot = switch s.picked {
        Some(one) { one }
        None { return Option<Slot>.None }
    }
    val owner = switch component_named(spot.component, s.components) {
        Some(one) { one }
        None { return Option<Slot>.None }
    }
    val base = switch list_holding(owner, spot.path) {
        Some(one) { one }
        None { return Option<Slot>.None }
    }
    val after = with base { index: base.index + 1 }
    val item = step_into(base.list, base.index)
    return switch box_of_node(shown, base.component, item) {
        Some(box) {
            Option<Slot>.Some(with after {
                at: trailing_edge(box, list_runs_across(owner, base.list))
            })
        }
        // Drawn by something with nowhere to hang a name -- an `expand`, a `flex`. The slot is
        // still real; only the line is unavailable.
        None { Option<Slot>.Some(after) }
    }
}

// Where the insertion line goes: past the far edge of the item the new node will follow, along
// the list's own axis.
fn trailing_edge(box: geom.Rect, across: bool) -> geom.Rect {
    if across {
        return geom.rect_of(box.x + box.width, box.y, 1.0, box.height)
    }
    return geom.rect_of(box.x, box.y + box.height, box.width, 1.0)
}

// Where a new item is written, and what to write there -- **which is not just the source**,
// because the comma goes on a different side in each case.
//
// Inserting in the middle lands *before* the item being displaced, which already carries the
// comma that separated it from its predecessor, so the new text needs one after it. Inserting at
// the end lands *after* the last item, where there is no comma at all, so it needs one before.
// Getting that backwards produces `, widget.flex()widget.expand(...)` -- two items with no
// separator, which the reader parses as a stray `?,` and a lost node, and which the first version
// of this did while its comment claimed one rule covered both.
//
// The whitespace is left to `--fmt`: the dialect's lint is only sound because the formatter runs
// first, and the same bargain pays here, so this has to produce valid syntax and nothing more.
pub struct Insertion {
    at: read_design.Span
    text: string
}

pub fn insertion_of(s: State, slot: Slot, source: string) -> Option<Insertion> {
    val owner = switch component_named(slot.component, s.components) {
        Some(c) { c }
        None { return Option<Insertion>.None }
    }
    val none: [read_design.Node] = []
    val items = switch read_design.node_at(tree_of(owner), slot.list) {
        Some(node) {
            switch node {
                List(got) { got.items }
                Call(_) { none }
                Struct(_) { none }
                Str(_) { none }
                Num(_) { none }
                Path(_) { none }
            }
        }
        None { none }
    }
    if len(items) == 0 {
        return Option<Insertion>.None
    }
    val from = owner.body_from
    if slot.index >= len(items) {
        val last = read_design.span_of(items[len(items) - 1])
        return Option<Insertion>.Some(Insertion {
            at: read_design.Span { from: from + last.to, to: from + last.to },
            text: concat(", ", source)
        })
    }
    val next = read_design.span_of(items[slot.index])
    return Option<Insertion>.Some(Insertion {
        at: read_design.Span { from: from + next.from, to: from + next.from },
        text: concat(source, ", ")
    })
}

// ------------------------------------------------- what an input does

// The design on show, laid out. **Laid out by the shell once per frame and handed to both halves**
// -- what is painted and what a press is routed by -- because two layouts of the same tree could
// disagree and a click would land on where a box used to be.
pub struct Shown {
    laid: widget.Laid
    spots: [Spot]
}

// **A write is asked for, not done.** Keeping `fs` out of `step` is what makes every case below
// reachable from a test with no file and no display, and the shell is a worse place to put
// behaviour precisely because nothing can reach it there.
pub struct Step {
    state: State
    write: bool
}

fn kept(s: State) -> Step {
    return Step { state: s, write: false }
}

// **By name over the laid tree, not through `focus`.** `focus.node_of` only ever looks at
// `Control` nodes, and the canvas is a named `Group` -- not a control, deliberately, because the
// design painted into it must not take the focus. Asking `focus` for it answers `None`, which is
// an empty box, which is a press that lands on whatever is behind the canvas: the first run of
// this program clicked the canvas and changed the component list.
//
// A name is inherited by every child that has none of its own, so the box wanted is the outermost
// one carrying it. **That walk lives in `lib/ui` now** -- `widget.node_named`, added the same day
// and for the same reason, because an input method needs the caret's box and the caret is a named
// group too. This was the private copy that asked for it.
pub fn bounds_of(laid: widget.Laid, name: string) -> geom.Rect {
    return switch widget.node_named(laid, name) {
        Some(node) { node.bounds }
        // A box the layout does not hold cannot have been pressed, and an empty rectangle makes
        // every hit test miss rather than inventing a position.
        None { geom.rect_of(0.0, 0.0, 0.0, 0.0) }
    }
}

// The bytes a node reads in the file as it stands.
pub fn source_of(s: State, spot: Spot) -> string {
    return switch component_named(spot.component, s.components) {
        Some(owner) {
            switch read_design.node_at(tree_of(owner), spot.path) {
                Some(node) {
                    val at = read_design.span_in_file(owner, node)
                    if at.from < 0 || at.to > len(s.text) || at.from >= at.to {
                        ""
                    } else {
                        substring(s.text, at.from, at.to)
                    }
                }
                None { "" }
            }
        }
        None { "" }
    }
}

fn with_source(s: State, text: string) -> State {
    return with s { source: controls.text_area_of("source", "Source", text, source_rows) }
}

// A state over new text, keeping what the user was looking at. **`state_of` cannot be reused**:
// it opens on `screen`, which is right for a file nobody has looked at yet and wrong for one the
// user is in the middle of editing.
fn reparsed(s: State, text: string) -> State {
    val all = read_design.components_of(text)
    val records = read_design.records_of(text)
    return with s {
        text: text,
        components: all,
        constants: read_design.constants_of(text),
        records: records,
        parts: with controls.list_of("parts", "Components", part_names(all)) {
            selected: s.parts.selected,
            offset: s.parts.offset
        },
        inputs: with controls.list_of("inputs", "Inputs", input_rows(records)) {
            selected: s.inputs.selected,
            offset: s.inputs.offset
        }
    }
}

// A press on the canvas selects the node under it, and nothing else about the window changes.
fn picked_at(s: State, shown: Shown, at: geom.Point) -> State {
    return switch render_design.spot_at(shown.laid, at, shown.spots) {
        Some(got) {
            val chosen = with s { picked: Option<Spot>.Some(got.spot) }
            with with_source(chosen, source_of(chosen, got.spot)) {
                status: format("selected in {}", got.spot.component)
            }
        }
        // **A miss clears the selection rather than keeping it.** An outline left over a node
        // nobody is pointing at is a lie about what Apply would rewrite.
        None {
            with with_source(with s { picked: Option<Spot>.None }, "") {
                status: "nothing there"
            }
        }
    }
}

fn is_tab(input: controls.Input) -> bool {
    return switch input {
        KeyDown(k) { controls.Key.is_Tab(k.key) }
        KeyUp(_) { false }
        Text(_) { false }
        Paste(_) { false }
        Press(_) { false }
        Release(_) { false }
        Move(_) { false }
        Wheel(_) { false }
    }
}

fn shift_held(input: controls.Input) -> bool {
    return switch input {
        KeyDown(k) { k.shift }
        KeyUp(k) { k.shift }
        Text(_) { false }
        Paste(_) { false }
        Press(_) { false }
        Release(_) { false }
        Move(_) { false }
        Wheel(_) { false }
    }
}

fn pressed_at(input: controls.Input) -> Option<geom.Point> {
    return switch input {
        Press(at) { Option<geom.Point>.Some(at) }
        KeyDown(_) { Option<geom.Point>.None }
        KeyUp(_) { Option<geom.Point>.None }
        Text(_) { Option<geom.Point>.None }
        Paste(_) { Option<geom.Point>.None }
        Release(_) { Option<geom.Point>.None }
        Move(_) { Option<geom.Point>.None }
        Wheel(_) { Option<geom.Point>.None }
    }
}

// Rewrites the picked node's span with what the inspector holds. The text is computed here and
// written by the shell.
fn applied(s: State) -> Step {
    return switch s.picked {
        Some(spot) {
            switch component_named(spot.component, s.components) {
                Some(owner) {
                    switch read_design.node_at(tree_of(owner), spot.path) {
                        Some(node) {
                            val at = read_design.span_in_file(owner, node)
                            val after = read_design.with_span_replaced(
                                s.text,
                                at,
                                s.source.editor.text
                            )
                            // **Re-read from the new text rather than patched.** Every span after
                            // this one has moved, and a tree that remembered the old ones would
                            // rewrite the wrong bytes on the very next Apply.
                            val grown = reparsed(s, after)
                            Step {
                                state: with with_source(grown, source_of(grown, spot)) {
                                    status: format(
                                        "rewrote {} of {}",
                                        read_design.path_text(spot.path),
                                        spot.component
                                    )
                                },
                                write: true
                            }
                        }
                        None { kept(with s { status: "that node is gone" }) }
                    }
                }
                None { kept(with s { status: "that component is gone" }) }
            }
        }
        None { kept(with s { status: "nothing selected" }) }
    }
}

// The bytes to cut to remove an item, **including one separator**, and which side that comma is
// on depends on where the item sits. Cutting the item alone leaves `[a, , c]`, which is a parse
// error in a file somebody was halfway through editing.
//
//   * not last -- cut to the start of the next item, taking the comma that followed this one
//   * last of several -- cut from the end of the previous item, taking the comma that preceded it
//   * the only item -- cut just the item, leaving an empty list
//
// An empty list is left deliberately rather than refused: a container with nothing in it is a
// thing a person building a screen passes through on the way to filling it, and a builder that
// would not let you empty a row would make you delete the row and make a new one.
pub fn deletion_of(s: State, slot: Slot) -> Option<read_design.Span> {
    val owner = switch component_named(slot.component, s.components) {
        Some(c) { c }
        None { return Option<read_design.Span>.None }
    }
    val items = list_items(owner, slot.list)
    if slot.index < 0 || slot.index >= len(items) {
        return Option<read_design.Span>.None
    }
    val from = owner.body_from
    val cur = read_design.span_of(items[slot.index])
    if len(items) == 1 {
        return Option<read_design.Span>.Some(read_design.Span {
            from: from + cur.from,
            to: from + cur.to
        })
    }
    if slot.index + 1 < len(items) {
        val next = read_design.span_of(items[slot.index + 1])
        return Option<read_design.Span>.Some(read_design.Span {
            from: from + cur.from,
            to: from + next.from
        })
    }
    val prev = read_design.span_of(items[slot.index - 1])
    return Option<read_design.Span>.Some(read_design.Span {
        from: from + prev.to,
        to: from + cur.to
    })
}

// The item the selection is, rather than the gap after it: `slot_after_selection` answers where a
// new node goes, and deleting is about the node that is already there.
pub fn slot_of_selection(s: State) -> Option<Slot> {
    val spot = switch s.picked {
        Some(one) { one }
        None { return Option<Slot>.None }
    }
    return switch component_named(spot.component, s.components) {
        Some(owner) { list_holding(owner, spot.path) }
        None { Option<Slot>.None }
    }
}

fn list_items(owner: Component, list: read_design.Path) -> [read_design.Node] {
    val none: [read_design.Node] = []
    return switch read_design.node_at(tree_of(owner), list) {
        Some(node) {
            switch node {
                List(got) { got.items }
                Call(_) { none }
                Struct(_) { none }
                Str(_) { none }
                Num(_) { none }
                Path(_) { none }
            }
        }
        None { none }
    }
}

fn removed(s: State) -> Step {
    val slot = switch slot_of_selection(s) {
        Some(one) { one }
        None { return kept(with s { status: "that node is not in a list" }) }
    }
    val cut = switch deletion_of(s, slot) {
        Some(one) { one }
        None { return kept(with s { status: "nothing to delete there" }) }
    }
    val grown = reparsed(s, read_design.with_span_replaced(s.text, cut, ""))
    return Step {
        // **The selection goes with the node.** A path that named the deleted item now names its
        // successor, so keeping it would outline a different node and Delete would eat the list.
        state: with with_source(with grown { picked: Option<Spot>.None }, "") {
            status: format("deleted item {} of {}", str(slot.index), read_design.path_text(slot.list))
        },
        write: true
    }
}

// Moves the selected item one place along its list.
//
// **Cut, re-read, paste -- in that order and with the re-read in the middle.** Every span after
// the cut has moved, so pasting against the offsets the cut was planned with would write into
// the wrong bytes. It is the same rule Apply follows for the same reason, and the reason there
// is a `reparsed` between the two edits rather than one combined splice.
//
// The arithmetic after the cut needs no adjustment and that is worth saying, because it looks
// like it should. Moving item `i` up means index `i - 1`, which is below the cut and so did not
// move; moving it down means `i + 1`, and the item that was there has slid into `i`, so `i + 1`
// is past it -- which is exactly where it belongs.
fn moved(s: State, by: int) -> Step {
    val slot = switch slot_of_selection(s) {
        Some(one) { one }
        None { return kept(with s { status: "that node is not in a list" }) }
    }
    val owner = switch component_named(slot.component, s.components) {
        Some(one) { one }
        None { return kept(with s { status: "that component is gone" }) }
    }
    val items = list_items(owner, slot.list)
    val target = slot.index + by
    if target < 0 || target >= len(items) {
        return kept(with s { status: if by < 0 { "already first" } else { "already last" } })
    }
    val here = read_design.span_of(items[slot.index])
    val source = substring(s.text, owner.body_from + here.from, owner.body_from + here.to)
    val cut = switch deletion_of(s, slot) {
        Some(one) { one }
        None { return kept(with s { status: "nothing to move there" }) }
    }
    val without = read_design.with_span_replaced(s.text, cut, "")
    val shorter = reparsed(s, without)
    val edit = switch insertion_of(shorter, with slot { index: target }, source) {
        Some(one) { one }
        None { return kept(with s { status: "nowhere to put it" }) }
    }
    val grown = reparsed(shorter, read_design.with_span_replaced(without, edit.at, edit.text))
    return Step {
        // The node has moved, so the path that named it names something else now.
        state: with with_source(with grown { picked: Option<Spot>.None }, "") {
            status: format("moved to {} of {}", str(target), read_design.path_text(slot.list))
        },
        write: true
    }
}

fn chosen_snippet(s: State) -> Option<Snippet> {
    val all = palette_items()
    if s.palette.selected < 0 || s.palette.selected >= len(all) {
        return Option<Snippet>.None
    }
    return Option<Snippet>.Some(all[s.palette.selected])
}

// Writes a new item into the list the selection sits in, after it.
//
// **The comma goes before the new text, not after.** Inserting at the end of a list means landing
// after the last item, where there is no comma yet; inserting in the middle means landing before
// the next one, which already has the comma that used to separate it from its predecessor. One
// rule covers both only because this always inserts *after* something.
//
// The whitespace is left to `--fmt`. The dialect's lint is only sound because the formatter runs
// first, and the same bargain pays here: `[a, b,c]` is a correct edit and a tidy one after a
// format, so this has to produce valid syntax and nothing more.
fn inserted(s: State, shown: Shown) -> Step {
    val snippet = switch chosen_snippet(s) {
        Some(one) { one }
        None { return kept(with s { status: "nothing chosen to add" }) }
    }
    val slot = switch slot_after_selection(s, shown) {
        Some(one) { one }
        None { return kept(with s { status: "that node is not in a list" }) }
    }
    val edit = switch insertion_of(s, slot, snippet.source) {
        Some(one) { one }
        None { return kept(with s { status: "that list is empty" }) }
    }
    val after = read_design.with_span_replaced(s.text, edit.at, edit.text)
    val grown = reparsed(s, after)
    return Step {
        state: with with_source(with grown { picked: Option<Spot>.None }, "") {
            status: format("added {} to {}", snippet.label, read_design.path_text(slot.list))
        },
        write: true
    }
}

pub fn step(
    s: State,
    input: controls.Input,
    laid: widget.Laid,
    shown: Shown,
    style: controls.Style,
    m: widget.Metrics
) -> Step {
    // Tab moves the focus and reaches no control, which is why it is taken before anything is
    // routed: a field that saw Tab would type it.
    if is_tab(input) {
        val moved = if shift_held(input) {
            focus.previous(laid, s.focused)
        } else {
            focus.next(laid, s.focused)
        }
        return kept(with s { focused: moved })
    }
    // **The canvas is taken before `controls.target`, and it has to be.** It is not a control: it
    // is a named box with another tree painted into it, so nothing in the focus order answers for
    // it and a press there would otherwise be delivered to whatever had the focus last.
    if Some(at) = pressed_at(input) {
        if widget.contains(bounds_of(laid, "canvas"), at) {
            return kept(picked_at(s, shown, at))
        }
    }
    val focused_now = switch pressed_at(input) {
        Some(at) { focus.clicked(laid, at, s.focused) }
        None { s.focused }
    }
    val here = with s { focused: focused_now }
    val name = controls.target(laid, input, focused_now)
    if name == "parts" {
        val taken = controls.list_input(here.parts, input, bounds_of(laid, "parts"))
        val moved = with here { parts: taken.list }
        if !taken.moved && !taken.activated {
            return kept(moved)
        }
        // **A new component clears the selection.** A path names a node of one component's tree
        // and means something else, or nothing, in another's -- keeping it would outline a box
        // that has no relation to what was clicked.
        return kept(with with_source(with moved { picked: Option<Spot>.None }, "") {
            status: format("showing {}", showing(moved))
        })
    }
    if name == "palette" {
        val taken = controls.list_input(here.palette, input, bounds_of(laid, "palette"))
        return kept(with here { palette: taken.list })
    }
    if name == "insert" {
        val taken = controls.button_input(here.insert, input, bounds_of(laid, "insert"))
        val pressed = with here { insert: taken.button }
        if taken.activated {
            return inserted(pressed, shown)
        }
        return kept(pressed)
    }
    if name == "remove" {
        val taken = controls.button_input(here.remove, input, bounds_of(laid, "remove"))
        val pressed = with here { remove: taken.button }
        if taken.activated {
            return removed(pressed)
        }
        return kept(pressed)
    }
    if name == "up" || name == "down" {
        val which = if name == "up" { here.up } else { here.down }
        val taken = controls.button_input(which, input, bounds_of(laid, name))
        val pressed = if name == "up" {
            with here { up: taken.button }
        } else {
            with here { down: taken.button }
        }
        if taken.activated {
            return moved(pressed, if name == "up" { 0 - 1 } else { 1 })
        }
        return kept(pressed)
    }
    if name == "inputs" {
        val taken = controls.list_input(here.inputs, input, bounds_of(laid, "inputs"))
        return kept(with here { inputs: taken.list })
    }
    if name == "source" {
        val taken = controls.entry_input(here.source, input, bounds_of(laid, "source"), style, m)
        return kept(with here { source: taken.entry })
    }
    if name == "apply" {
        val taken = controls.button_input(here.apply, input, bounds_of(laid, "apply"))
        val pressed = with here { apply: taken.button }
        if taken.activated {
            return applied(pressed)
        }
        return kept(pressed)
    }
    if name == "revert" {
        val taken = controls.button_input(here.revert, input, bounds_of(laid, "revert"))
        val pressed = with here { revert: taken.button }
        if !taken.activated {
            return kept(pressed)
        }
        return switch pressed.picked {
            Some(spot) {
                kept(with with_source(pressed, source_of(pressed, spot)) { status: "reverted" })
            }
            None { kept(with pressed { status: "nothing selected" }) }
        }
    }
    return kept(here)
}
