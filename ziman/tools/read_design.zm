// Reads a design file the way a UI builder would, and proves it can be read.
//
// **The dialect rests on one claim: the subset is about as hard to parse as JSON.** That is an
// argument until something parses it, so this does -- tokenise a `*_ui.zm`, parse each `pub fn`'s
// body into a tree of calls, literals, paths, lists and struct literals, and either print the
// tree or check that every component in every design file comes out whole.
//
// **`--check` is the gate, and it is a stronger statement than the lint beside it.**
// `lint_design.zm` says no forbidden keyword appears; this says a program can actually read the
// file. The second implies the first and does not depend on a list of words -- a construct nobody
// thought to forbid still fails here, because the parser stops and the leftover tokens are
// counted. Four of the lint's own fixture functions fail it for exactly that reason.
//
//     ziman tools/read_design.zm -- --check src/main/ziman
//     ziman tools/read_design.zm -- src/main/ziman/gui/request_ui.zm screen
//
// What it does **not** do is render. Turning this tree into a window needs a registry from a call
// name to a control, which is the builder's next piece and not this one's.
use fs
use os

// **Where a token was, not just what it was.** An editor rewrites the span a node occupies and
// leaves every other byte alone -- which the round trip showed is the only way to save a design
// file without deleting half of it -- and a span is only knowable if the tokens underneath carry
// one. `from` and `to` are offsets into the text that was tokenised.
pub struct Token {
    kind: string
    text: string
    from: int
    to: int
}

// Where something sits in the text it was read from. **Half-open, like every other range here**:
// `from` is the first character and `to` is one past the last, so `to - from` is the length and
// `substring(text, from, to)` is exactly what was read.
pub struct Span {
    from: int
    to: int
}

// A parsed expression. Recursive, like the widget tree it describes, and **every node carries the
// span it came from** -- which is what lets an editor rewrite one node and leave every other byte
// of the file alone. The round trip showed why that matters: regenerating a design file deletes
// its comments, collapses its derived constants and drops a `pub`.
pub struct Call {
    name: string
    args: [Node]
    at: Span
}

pub struct Fields {
    name: string
    keys: [string]
    values: [Node]
    at: Span
}

pub struct Items {
    items: [Node]
    at: Span
}

// A literal or a name: the text, and where it was.
pub struct Leaf {
    text: string
    at: Span
}

pub enum Node {
    Call(Call)
    Struct(Fields)
    List(Items)
    Str(Leaf)
    Num(Leaf)
    Path(Leaf)
}

pub fn span_of(node: Node) -> Span {
    return switch node {
        Call(c) { c.at }
        Struct(f) { f.at }
        List(items) { items.at }
        Str(leaf) { leaf.at }
        Num(leaf) { leaf.at }
        Path(leaf) { leaf.at }
    }
}

pub fn text_of(node: Node) -> string {
    return switch node {
        Call(c) { c.name }
        Struct(f) { f.name }
        List(_) { "" }
        Str(leaf) { leaf.text }
        Num(leaf) { leaf.text }
        Path(leaf) { leaf.text }
    }
}

val digits = "0123456789"
val name_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
val punctuation = "().,[]{}:"

fn is_in(set: string, ch: string) -> bool {
    return contains(set, ch)
}

// ------------------------------------------------------------------- tokens

pub fn tokens_of(source: string) -> [Token] {
    val out = mutable_array_new<Token>()
    val n = len(source)
    var i = 0
    while i < n {
        val ch = substring(source, i, i + 1)
        if ch == " " || ch == "\n" || ch == "\t" || ch == "\r" {
            i = i + 1
            continue
        }
        if i + 2 <= n && substring(source, i, i + 2) == "//" {
            while i < n && substring(source, i, i + 1) != "\n" {
                i = i + 1
            }
            continue
        }
        if ch == "\"" {
            var j = i + 1
            var text = ""
            while j < n && substring(source, j, j + 1) != "\"" {
                text = concat(text, substring(source, j, j + 1))
                j = j + 1
            }
            push(out, Token { kind: "str", text: text, from: i, to: j + 1 })
            i = j + 1
            continue
        }
        if is_in(digits, ch) {
            var j = i
            while j < n && (is_in(digits, substring(source, j, j + 1)) || substring(source, j, j + 1) == ".") {
                j = j + 1
            }
            push(out, Token { kind: "num", text: substring(source, i, j), from: i, to: j })
            i = j
            continue
        }
        if is_in(name_chars, ch) {
            var j = i
            while j < n && is_in(name_chars, substring(source, j, j + 1)) {
                j = j + 1
            }
            push(out, Token { kind: "ident", text: substring(source, i, j), from: i, to: j })
            i = j
            continue
        }
        if is_in(punctuation, ch) {
            push(out, Token { kind: "punct", text: ch, from: i, to: i + 1 })
            i = i + 1
            continue
        }
        // Anything else is not in the dialect; say so rather than skipping it quietly.
        push(out, Token { kind: "other", text: ch, from: i, to: i + 1 })
        i = i + 1
    }
    return snapshot(out)
}

// ------------------------------------------------------------------- parsing

pub struct Parsed {
    node: Node
    next: int
}

fn token_at(ts: [Token], i: int) -> Token {
    if i < len(ts) {
        return ts[i]
    }
    return Token { kind: "end", text: "", from: 0, to: 0 }
}

// A dotted name: `widget.fixed_of`, `it.filter`, `widget.Direction.Column`.
fn path_at(ts: [Token], start: int) -> Parsed {
    val first = token_at(ts, start)
    var name = first.text
    var last = first.to
    var i = start + 1
    while token_at(ts, i).text == "." && token_at(ts, i + 1).kind == "ident" {
        name = concat(name, ".", token_at(ts, i + 1).text)
        last = token_at(ts, i + 1).to
        i = i + 2
    }
    return Parsed {
        node: Node.Path(Leaf { text: name, at: Span { from: first.from, to: last } }),
        next: i
    }
}

pub fn expr_at(ts: [Token], start: int) -> Parsed {
    val t = token_at(ts, start)
    if t.kind == "str" {
        return Parsed {
            node: Node.Str(Leaf { text: t.text, at: Span { from: t.from, to: t.to } }),
            next: start + 1
        }
    }
    if t.kind == "num" {
        return Parsed {
            node: Node.Num(Leaf { text: t.text, at: Span { from: t.from, to: t.to } }),
            next: start + 1
        }
    }
    if t.text == "[" {
        val items = mutable_array_new<Node>()
        var i = start + 1
        while token_at(ts, i).text != "]" && token_at(ts, i).kind != "end" {
            val one = expr_at(ts, i)
            push(items, one.node)
            i = one.next
            if token_at(ts, i).text == "," {
                i = i + 1
            }
        }
        val close = token_at(ts, i)
        return Parsed {
            node: Node.List(Items {
                items: snapshot(items),
                at: Span { from: t.from, to: close.to }
            }),
            next: i + 1
        }
    }
    if t.kind == "ident" {
        val p = path_at(ts, start)
        val name = text_of(p.node)
        if token_at(ts, p.next).text == "(" {
            val args = mutable_array_new<Node>()
            var i = p.next + 1
            while token_at(ts, i).text != ")" && token_at(ts, i).kind != "end" {
                val one = expr_at(ts, i)
                push(args, one.node)
                i = one.next
                if token_at(ts, i).text == "," {
                    i = i + 1
                }
            }
            val close = token_at(ts, i)
            return Parsed {
                node: Node.Call(Call {
                    name: name,
                    args: snapshot(args),
                    at: Span { from: t.from, to: close.to }
                }),
                next: i + 1
            }
        }
        if token_at(ts, p.next).text == "{" {
            val keys = mutable_array_new<string>()
            val values = mutable_array_new<Node>()
            var i = p.next + 1
            while token_at(ts, i).text != "}" && token_at(ts, i).kind != "end" {
                push(keys, token_at(ts, i).text)
                // name, colon, value
                val one = expr_at(ts, i + 2)
                push(values, one.node)
                i = one.next
                if token_at(ts, i).text == "," {
                    i = i + 1
                }
            }
            val close = token_at(ts, i)
            return Parsed {
                node: Node.Struct(Fields {
                    name: name,
                    keys: snapshot(keys),
                    values: snapshot(values),
                    at: Span { from: t.from, to: close.to }
                }),
                next: i + 1
            }
        }
        return p
    }
    // Not in the dialect: hand it back as a path so the caller can see what stopped it.
    return Parsed {
        node: Node.Path(Leaf { text: concat("?", t.text), at: Span { from: t.from, to: t.to } }),
        next: start + 1
    }
}

// Anything the parser could not place, which is what makes this a gate rather than a demo: a
// design file is only useful to a builder if a builder can read it, and "no forbidden keyword"
// is a weaker statement than "it parses".
pub fn unparsed_in(node: Node) -> int {
    switch node {
        Call(c) {
            var n = 0
            for a in c.args {
                n = n + unparsed_in(a)
            }
            return n
        }
        Struct(f) {
            var n = 0
            for v in f.values {
                n = n + unparsed_in(v)
            }
            return n
        }
        List(items) {
            var n = 0
            for one in items.items {
                n = n + unparsed_in(one)
            }
            return n
        }
        Str(_) { return 0 }
        Num(_) { return 0 }
        Path(leaf) { return if starts_with(leaf.text, "?") { 1 } else { 0 } }
    }
    return 0
}

// ------------------------------------------------------------------- printing

fn indent_of(depth: int) -> string {
    var out = ""
    for _ in 0..depth {
        out = concat(out, "  ")
    }
    return out
}

pub fn show(node: Node, depth: int) {
    switch node {
        Call(c) {
            print(format("{}{}(", indent_of(depth), c.name))
            for a in c.args {
                show(a, depth + 1)
            }
            print(format("{})", indent_of(depth)))
        }
        Struct(f) {
            print(format("{}{} {{", indent_of(depth), f.name))
            var i = 0
            for key in f.keys {
                print(format("{}{}:", indent_of(depth + 1), key))
                show(f.values[i], depth + 2)
                i = i + 1
            }
            print(format("{}}}", indent_of(depth)))
        }
        List(items) {
            print(format("{}[", indent_of(depth)))
            for one in items.items {
                show(one, depth + 1)
            }
            print(format("{}]", indent_of(depth)))
        }
        Str(leaf) { print(format("{}\"{}\"", indent_of(depth), leaf.text)) }
        Num(leaf) { print(format("{}{}", indent_of(depth), leaf.text)) }
        Path(leaf) { print(format("{}{}", indent_of(depth), leaf.text)) }
    }
}

// --------------------------------------------------------- functions in a file

// A struct a design file declares -- its data interface. **This is the one thing an editor most
// needs**: a single list saying exactly what a screen consumes, from which it can synthesise a
// placeholder per field and draw the component on its own.
pub struct Field {
    name: string
    said: string
}

pub struct Record {
    name: string
    fields: [Field]
}

pub fn records_of(text: string) -> [Record] {
    val out = mutable_array_new<Record>()
    var name = ""
    val fields = mutable_array_new<Field>()
    for line in lines(text) {
        val code = trim(code_of(line))
        if starts_with(code, "pub struct ") && ends_with(code, "{") {
            name = trim(substring(code, 11, len(code) - 1))
            continue
        }
        if name == "" {
            continue
        }
        if code == "}" {
            push(out, Record { name: name, fields: snapshot(fields) })
            clear(fields)
            name = ""
            continue
        }
        if Some(halves) = split_once(code, ": ") {
            push(fields, Field { name: trim(halves[0]), said: trim(halves[1]) })
        }
    }
    return snapshot(out)
}

pub struct Param {
    name: string
    said: string
}

// **Every function, not only the exported ones.** `pub` says what a builder may *offer* in a
// palette; it does not say what a builder must *resolve*. A component that calls a private helper
// still has to render, so the reader collects both and marks which is which. Getting that wrong
// showed up immediately: `pair_table` calls a private `padded_below`, and a reader that skipped
// private functions could not draw it.
pub struct Component {
    name: string
    exported: bool
    params: [Param]
    body: string
    // Where `body` starts in the file it came from, so a token's offset inside it can be turned
    // into an offset into the file -- which is what an edit needs to rewrite one span.
    body_from: int
}

// A module-level constant, already evaluated. **Arithmetic is allowed in one** -- it is how
// `editor_strip_width = tab_width * editor_tabs` keeps one number in one place -- so the table is
// read in order and a later constant may use an earlier one. Nothing else may: no calls, no
// parameters, no state, which is what keeps this a table rather than an interpreter.
pub struct Constant {
    name: string
    value: float
}

// The code on a line, with any trailing comment dropped. A `//` inside a string is not a
// comment, but a constant's value is a number or a name, so a plain search is enough here.
fn code_of(line: string) -> string {
    val at = index_of(line, "//", 0)
    return if at < 0 { line } else { substring(line, 0, at) }
}

fn number_of(word: string, known: [Constant]) -> float {
    for c in known {
        if c.name == word {
            return c.value
        }
    }
    return switch parse_float(word) {
        Ok(f) { f }
        Err(_) { 0.0 }
    }
}

pub fn constants_of(text: string) -> [Constant] {
    val out = mutable_array_new<Constant>()
    for line in lines(text) {
        val code = trim(code_of(line))
        val body = if starts_with(code, "pub val ") {
            substring(code, 8, len(code))
        } else {
            if starts_with(code, "val ") { substring(code, 4, len(code)) } else { "" }
        }
        if body == "" {
            continue
        }
        if Some(parts) = split_once(body, " = ") {
            val name = trim(parts[0])
            val words = split(trim(parts[1]), " ")
            var value = number_of(words[0], snapshot(out))
            var i = 1
            while i + 1 < len(words) {
                val operator = words[i]
                val next = number_of(words[i + 1], snapshot(out))
                if operator == "*" {
                    value = value * next
                }
                if operator == "+" {
                    value = value + next
                }
                if operator == "-" {
                    value = value - next
                }
                i = i + 2
            }
            push(out, Constant { name: name, value: value })
        }
    }
    return snapshot(out)
}

// The parameters of a signature, which is a component's inputs -- what a builder shows as a panel
// and what it must synthesise a placeholder for to draw the thing on its own.
fn params_of(signature: string) -> [Param] {
    val out = mutable_array_new<Param>()
    val open = index_of(signature, "(", 0)
    val close = index_of(signature, ")", 0)
    if open < 0 || close < open {
        return snapshot(out)
    }
    val inside = substring(signature, open + 1, close)
    for piece in split(inside, ",") {
        val one = trim(piece)
        if one == "" {
            continue
        }
        if Some(halves) = split_once(one, ": ") {
            push(out, Param { name: trim(halves[0]), said: trim(halves[1]) })
        }
    }
    return snapshot(out)
}

// Every `pub fn`, with the text of its body. Line-oriented, which the formatter makes sound.
pub fn components_of(text: string) -> [Component] {
    val out = mutable_array_new<Component>()
    var collecting = false
    var name = ""
    var signature = ""
    var exported = false
    var body_from = 0
    var offset = 0
    for line in lines(text) {
        val line_from = offset
        // Every line costs its own length plus the newline that followed it, which is what makes
        // `body` below an exact slice of the file rather than a copy that merely looks like one.
        offset = offset + len(line) + 1
        if starts_with(line, "pub fn ") || starts_with(line, "fn ") {
            val shown = starts_with(line, "pub fn ")
            exported = shown
            val rest = if shown { substring(line, 7, len(line)) } else { substring(line, 3, len(line)) }
            val at = index_of(rest, "(", 0)
            name = if at > 0 { substring(rest, 0, at) } else { rest }
            signature = trim(line)
            collecting = ends_with(trim(line), "{")
            body_from = offset
            continue
        }
        if !collecting && name != "" && !starts_with(trim(line), "//") {
            signature = concat(signature, " ", trim(line))
            if ends_with(trim(line), "{") {
                collecting = true
                body_from = offset
            }
            continue
        }
        if collecting {
            if line == "}" {
                push(out, Component {
                    name: name,
                    exported: exported,
                    params: params_of(signature),
                    body: substring(text, body_from, line_from),
                    body_from: body_from
                })
                collecting = false
                name = ""
                continue
            }
        }
    }
    return snapshot(out)
}

// ------------------------------------------------------------------- editing

// Where a node sits **in the file**, rather than in the component's body. A body is an exact
// slice, so this is one addition -- which is the whole reason `body_from` is recorded.
pub fn span_in_file(c: Component, node: Node) -> Span {
    val at = span_of(node)
    return Span { from: c.body_from + at.from, to: c.body_from + at.to }
}

// Where a node sits in the tree: the child index at each level, from the root down. **This is how
// a node is named**, and the reason is that nothing else is stable. Addressing by the text a node
// reads -- which this probe did first -- picks the wrong one the moment two nodes read the same
// thing, and `gap` appears eleven times in one component. A click cannot produce text either: a
// builder knows which box was pressed, and a box is a position.
pub struct Path {
    steps: [int]
}

// A node's children, in the order they are written. The three kinds that have any.
pub fn children_of(node: Node) -> [Node] {
    return switch node {
        Call(c) { c.args }
        Struct(f) { f.values }
        List(items) { items.items }
        Str(_) { [] }
        Num(_) { [] }
        Path(_) { [] }
    }
}

pub fn node_at(root: Node, path: Path) -> Option<Node> {
    var here = root
    for step in path.steps {
        val kids = children_of(here)
        if step < 0 || step >= len(kids) {
            return Option<Node>.None
        }
        here = kids[step]
    }
    return Option<Node>.Some(here)
}

// Every path in the tree, root first. What a builder would hold one of per box it drew.
pub fn paths_in(root: Node) -> [Path] {
    val out = mutable_array_new<Path>()
    push(out, Path { steps: [] })
    collect_paths(root, [], out)
    return snapshot(out)
}

fn collect_paths(node: Node, prefix: [int], out: MutableArray<Path>) {
    var index = 0
    for child in children_of(node) {
        val here = mutable_array_new<int>()
        for step in prefix {
            push(here, step)
        }
        push(here, index)
        val steps = snapshot(here)
        push(out, Path { steps: steps })
        collect_paths(child, steps, out)
        index = index + 1
    }
}

pub fn path_text(path: Path) -> string {
    if len(path.steps) == 0 {
        return "root"
    }
    var out = ""
    var first = true
    for step in path.steps {
        if !first {
            out = concat(out, ".")
        }
        out = concat(out, str(step))
        first = false
    }
    return out
}

// The path of the first node reading `wanted`, depth first. **A probe's way of naming a node, not
// the interface**: a builder addresses by path because it knows which box was clicked. This is how
// a command line names one.
pub fn path_of_text(root: Node, wanted: string) -> Option<Path> {
    for path in paths_in(root) {
        switch node_at(root, path) {
            Some(node) {
                if text_of(node) == wanted {
                    return Option<Path>.Some(path)
                }
            }
            None { unit }
        }
    }
    return Option<Path>.None
}

// **One span rewritten, every other byte kept.** This is what the round trip said an editor has
// to do instead of regenerating: the comments, the derived constants and the `pub` that a rewrite
// loses are not reproduced here, they are simply never touched.
pub fn with_span_replaced(text: string, at: Span, replacement: string) -> string {
    return concat(substring(text, 0, at.from), replacement, substring(text, at.to, len(text)))
}

// A directory to sweep, or one file to check on its own -- which is how a gate can say "this
// file must pass" about a fixture that lives beside one that must fail.
fn design_files(root: string) -> [string] {
    if ends_with(root, ".zm") {
        return [root]
    }
    val out = mutable_array_new<string>()
    walk(root, out)
    return snapshot(out)
}

fn walk(dir: string, out: MutableArray<string>) {
    switch fs.list_dir(dir) {
        Ok(names) {
            for name in names {
                val path = fs.path_join(dir, name)
                if fs.is_dir(path) {
                    walk(path, out)
                } else {
                    if ends_with(name, "_ui.zm") {
                        push(out, path)
                    }
                }
            }
        }
        Err(_) { unit }
    }
}

// Every node's span, in the order `paths_in` walks them: a node, then each child's subtree.
//
// **Written out by hand rather than over `children_of`, and that is the point.** The check below
// compares this walk against the paths, and the paths are built from `children_of` -- so if this
// used it too, both sides would move together and a `children_of` that forgot a node kind would
// pass. It did: dropping a struct's values from `children_of` changed nothing until this walk
// stopped sharing it. Matching the variants here is the only thing in the comparison that does
// not depend on what `children_of` thinks a child is.
fn spans_in(node: Node, out: MutableArray<Span>) {
    push(out, span_of(node))
    switch node {
        Call(c) {
            for a in c.args {
                spans_in(a, out)
            }
        }
        Struct(f) {
            for v in f.values {
                spans_in(v, out)
            }
        }
        List(items) {
            for one in items.items {
                spans_in(one, out)
            }
        }
        Str(_) { unit }
        Num(_) { unit }
        Path(_) { unit }
    }
}

// Every component of every design file under `root` must parse, with nothing left over.
fn check(root: string) {
    val files = design_files(root)
    var components = 0
    var bad = 0
    for file in files {
        val text = switch fs.read_text(file) {
            Ok(t) { t }
            Err(why) {
                print(format("read_design: cannot read {}: {}", file, why))
                os.exit(1)
                ""
            }
        }
        for c in components_of(text) {
            components = components + 1
            val ts = tokens_of(c.body)
            val start = if token_at(ts, 0).text == "return" { 1 } else { 0 }
            val parsed = expr_at(ts, start)
            val left = unparsed_in(parsed.node)
            // A trailing token is as much a failure as an unknown one: it means the parser stopped
            // early and the tree it returned is not the whole component.
            val trailing = len(ts) - parsed.next
            if left > 0 || trailing > 0 {
                bad = bad + 1
                print(format(
                    "{}: {} did not parse -- {} token(s) outside the dialect, {} left over",
                    file,
                    c.name,
                    str(left),
                    str(trailing)
                ))
            }
            // **Every path must name exactly one node, and the same one tomorrow.** A builder
            // holds a path per box it drew and asks for that node when the box is clicked, so a
            // path resolving to nothing -- or to a node whose span is not where the walk found it
            // -- is a selection landing on the wrong thing. Checked by walking the tree and the
            // paths side by side: the nth path must be the nth node.
            val walked = mutable_array_new<Span>()
            spans_in(parsed.node, walked)
            val addressed = paths_in(parsed.node)
            val wanted = snapshot(walked)
            if len(wanted) != len(addressed) {
                bad = bad + 1
                print(format(
                    "{}: {} has {} node(s) but {} path(s)",
                    file,
                    c.name,
                    str(len(wanted)),
                    str(len(addressed))
                ))
            } else {
                var n = 0
                for path in addressed {
                    val found = switch node_at(parsed.node, path) {
                        Some(node) { span_of(node) }
                        None { Span { from: 0 - 1, to: 0 - 1 } }
                    }
                    if found.from != wanted[n].from || found.to != wanted[n].to {
                        bad = bad + 1
                        print(format(
                            "{}: {} path {} resolves to {}..{}, not {}..{}",
                            file,
                            c.name,
                            path_text(path),
                            str(found.from),
                            str(found.to),
                            str(wanted[n].from),
                            str(wanted[n].to)
                        ))
                    }
                    n = n + 1
                }
            }
        }
    }
    if bad > 0 {
        print(format("read_design: {} of {} component(s) unreadable by a builder", str(bad), str(components)))
        os.exit(1)
    }
    print(format(
        "read_design: {} component(s) in {} design file(s), every one parses",
        str(components),
        str(len(files))
    ))
}

fn main() {
    val args = os.args()
    if len(args) > 0 && args[0] == "--check" {
        check(if len(args) > 1 { args[1] } else { "src/main/ziman" })
        return
    }
    val path = if len(args) > 0 { args[0] } else { "src/main/ziman/gui/request_ui.zm" }
    val wanted = if len(args) > 1 { args[1] } else { "screen" }
    val text = switch fs.read_text(path) {
        Ok(t) { t }
        Err(why) {
            print(format("cannot read {}: {}", path, why))
            return
        }
    }
    val found = components_of(text)
    print(format("{} function(s): ", str(len(found))))
    for c in found {
        print(format("  {}{}", c.name, if c.exported { "" } else { "  (private)" }))
    }
    for c in found {
        if c.name == wanted {
            print(format("\n--- {} ---", c.name))
            val ts = tokens_of(c.body)
            print(format("{} tokens", str(len(ts))))
            // The body is `return <expr>`, so the expression starts after the keyword.
            val start = if token_at(ts, 0).text == "return" { 1 } else { 0 }
            show(expr_at(ts, start).node, 0)
        }
    }
}
