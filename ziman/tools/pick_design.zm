// Turns a point on the canvas into a node of the design file -- the step that makes a renderer an
// editor rather than a preview.
//
// **The question this answers is the one a visual editor opens with**: a user clicks a box, and
// the editor has to say which bytes of which file that box came from. `read_design` gave nodes
// their spans and `render_design` gave them names; this is the lookup that joins the two, and the
// check below is the only thing that says the join is real rather than plausible.
//
//   pick_design.zm <file> <component> <x> <y>   what is under that point
//   pick_design.zm --check [root]               every control resolves to the node that drew it
use controls
use font
use fs
use geom
use os
use tools/read_design
use tools/read_design.Component
use tools/render_design
use tools/render_design.Spot
use widget

val canvas = geom.rect_of(0.0, 0.0, 900.0, 700.0)

fn component_named(name: string, all: [Component]) -> Option<Component> {
    for c in all {
        if c.name == name {
            return Option<Component>.Some(c)
        }
    }
    return Option<Component>.None
}

// The root node of a component's body, parsed.
fn tree_of(c: Component) -> read_design.Node {
    val ts = read_design.tokens_of(c.body)
    val start = if len(ts) > 0 && ts[0].text == "return" { 1 } else { 0 }
    return read_design.expr_at(ts, start).node
}

pub struct Found {
    name: string
    bounds: geom.Rect
}

// Every control in a laid-out tree, by the name the design gave it. **This is the independent
// end of the check.** It comes from `widget.layout`, which knows nothing about spans, paths or
// the spot table -- so a control's box and the node that drew it meet only if the naming is
// right, and an off-by-one in a path shows up as a node that does not mention the control.
fn controls_in(l: widget.Laid, out: MutableArray<Found>) {
    if Control(c) = l.widget {
        push(out, Found { name: c.name, bounds: l.bounds })
    }
    for child in l.children {
        controls_in(child, out)
    }
}

fn centre(r: geom.Rect) -> geom.Point {
    return geom.point_of(r.x + r.width / 2.0, r.y + r.height / 2.0)
}

fn spot_named(spots: [Spot], tag: string) -> Option<Spot> {
    for one in spots {
        if one.tag == tag {
            return Option<Spot>.Some(one)
        }
    }
    return Option<Spot>.None
}

fn metrics() -> widget.Metrics {
    // **A measured font, not a stub.** A stub metric is fine for asserting that two boxes differ,
    // and useless here: the whole question is where a real glyph run puts a real box.
    val font_path = switch os.get_env("ZIMAN_FONT") {
        Some(p) { p }
        None { "../../ziman/vendor/fonts/Caladea-Regular.ttf" }
    }
    var found = widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 7.0 },
        fn(size: float) -> float { return size * 1.4 }
    )
    switch fs.read_bytes(font_path) {
        Ok(data) {
            switch font.load(data) {
                Ok(face) {
                    switch widget.metrics_for(face) {
                        Ok(got) { found = got }
                        Err(why) {
                            print(format("metrics: {}", why))
                            os.exit(1)
                        }
                    }
                }
                Err(why) {
                    print(format("load {}: {}", font_path, why))
                    os.exit(1)
                }
            }
        }
        Err(why) {
            print(format("font ({}): {}", font_path, why))
            os.exit(1)
        }
    }
    return found
}

fn read(path: string) -> string {
    return switch fs.read_text(path) {
        Ok(t) { t }
        Err(why) {
            print(format("pick_design: cannot read {}: {}", path, why))
            os.exit(1)
            ""
        }
    }
}

fn design_files(root: string) -> [string] {
    val out = mutable_array_new<string>()
    walk(root, out)
    return snapshot(out)
}

fn walk(dir: string, out: MutableArray<string>) {
    switch fs.list_dir(dir) {
        Ok(names) {
            for name in names {
                val path = fs.path_join(dir, name)
                if fs.is_dir(path) {
                    walk(path, out)
                } else {
                    if ends_with(name, "_ui.zm") {
                        push(out, path)
                    }
                }
            }
        }
        Err(_) { unit }
    }
}

// What one component says about itself: how many nodes a click can name, and whether every
// control in it can be found by clicking the middle of it.
//
// **Three things are asserted, and only the third is about the clicking.** The first two are
// about the table: a path that resolves to nothing is an off-by-one in the walk, and two nodes
// sharing a tag is a lookup that answers the wrong one. The third is the end-to-end claim, and
// its two ends come from machinery that never meets: a control's box is where `widget.layout`
// put it, and the node's text is what the parser read. They agree only if the naming is right.
fn check_component(
    file: string,
    text: string,
    c: Component,
    all: [Component],
    known: [read_design.Constant],
    records: [read_design.Record],
    m: widget.Metrics
) -> int {
    var bad = 0
    val shop = render_design.shop_of(known, all, records, controls.default_style(), m)
    val drawn = render_design.render(c, [], shop)
    val spots = snapshot(shop.spots)
    val laid = widget.layout(render_design.widget_of(drawn), canvas, m)

    // 1. Every path names a node that is there.
    for one in spots {
        switch component_named(one.component, all) {
            Some(owner) {
                if Option.is_None(read_design.node_at(tree_of(owner), one.path)) {
                    print(format(
                        "{}: {} -- {} names {} in {}, which is not a node",
                        file,
                        c.name,
                        one.tag,
                        read_design.path_text(one.path),
                        one.component
                    ))
                    bad = bad + 1
                }
            }
            None {
                print(format(
                    "{}: {} -- {} names component {}, which is not here",
                    file,
                    c.name,
                    one.tag,
                    one.component
                ))
                bad = bad + 1
            }
        }
    }

    // 2. One tag, one node.
    var i = 0
    while i < len(spots) {
        var j = i + 1
        while j < len(spots) {
            if spots[i].tag == spots[j].tag {
                print(format("{}: {} -- two nodes answer to {}", file, c.name, spots[i].tag))
                bad = bad + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    // 3. The middle of every control resolves to a node that drew it.
    val found = mutable_array_new<Found>()
    controls_in(laid, found)
    for one in found {
        if one.bounds.width <= 0.0 || one.bounds.height <= 0.0 {
            continue
        }
        // **A control the window itself cannot reach is not this tool's to answer for**, and the
        // preview is where it comes from. A press at the control's own middle must at least pass
        // *through* it -- not land on it: a tab strip's middle lands on one of its tabs and a
        // button's on its label, and both are reachable. If the control is nowhere in the chain
        // under its own centre, no mapping from a point could have found it either.
        //
        // In a preview this is usually the placeholder's fault rather than the design's: a
        // `controls.Tabs` nobody filled in is drawn with three items, and `pane_switcher` sizes
        // its strip `tab_width * pane_tabs` with `pane_tabs = 2.0`. The third tab is laid past
        // the end of the strip, and a box laid outside its parent is painted and cannot be
        // clicked -- `Fixed` sizes, it does not clip, which `Scroll` does on purpose and this
        // does by accident. Reported rather than failed, because with invented data the two
        // causes are the same picture.
        if !reachable(laid, centre(one.bounds), one.name) {
            print(format(
                "{}: {} -- note: '{}' is drawn where a press cannot reach it",
                file,
                c.name,
                one.name
            ))
            continue
        }
        switch render_design.spot_at(laid, centre(one.bounds), spots) {
            Some(spot) {
                val owner = switch component_named(spot.component, all) {
                    Some(o) { o }
                    None { c }
                }
                // **The bytes of the file, not the head of the node.** `text_of` answers
                // `controls.button_widget` for every button there is, which a check for the
                // control's name passes or fails by accident. The span is the thing an editor
                // would select, so it is the thing to assert on.
                val node = read_design.node_at(tree_of(owner), spot.path)
                val said = switch node {
                    Some(got) { source_of(owner, got, text) }
                    None { "" }
                }
                // **A control is drawn by a `controls.` call and by nothing else**, so that is
                // what a click on one has to land on. Without this the check is satisfied by any
                // node whose source happens to contain the name -- and the component's own root
                // contains every name in the component, so a mapping that answered "the root" to
                // every point passed. Mutation said so: pointing every path at `[]` was clean.
                val head = switch node {
                    Some(got) { read_design.text_of(got) }
                    None { "" }
                }
                if !starts_with(head, "controls.") {
                    print(format(
                        "{}: {} -- the middle of '{}' lands on {} of {}, which is {} and not a control",
                        file,
                        c.name,
                        one.name,
                        read_design.path_text(spot.path),
                        spot.component,
                        if head == "" { "nothing" } else { head }
                    ))
                    bad = bad + 1
                    continue
                }
                // **The name it is known by where it is drawn.** A control is named for the field
                // it came from -- `editors` -- and the component that draws it received it under
                // a parameter name of its own -- `tabs`. Both are the same control; only the
                // second is in the source. A sub-control `controls` invented while drawing, a
                // tree row or a tab, is named `tree/2` and resolves to the tree, which the
                // parameter name covers as well.
                if !mentions(said, one.name, owner) {
                    print(format(
                        "{}: {} -- the middle of '{}' lands on {} of {}, which reads {}",
                        file,
                        c.name,
                        one.name,
                        read_design.path_text(spot.path),
                        spot.component,
                        said
                    ))
                    bad = bad + 1
                }
            }
            None {
                print(format(
                    "{}: {} -- the middle of '{}' lands on no node at all",
                    file,
                    c.name,
                    one.name
                ))
                bad = bad + 1
            }
        }
    }
    return bad
}

fn reachable(l: widget.Laid, p: geom.Point, name: string) -> bool {
    for one in widget.chain_at(l, p) {
        if one.name == name {
            return true
        }
    }
    return false
}

// Whether a node's source names the control, under either of the two names a control has here.
fn mentions(said: string, control: string, owner: Component) -> bool {
    if contains(said, control) {
        return true
    }
    for p in owner.params {
        if contains(said, p.name) {
            return true
        }
    }
    return false
}

// The source a node was written as. One line, because a node spanning several is reported on the
// line it starts.
fn source_of(owner: Component, node: read_design.Node, text: string) -> string {
    val at = read_design.span_in_file(owner, node)
    if at.from < 0 || at.to > len(text) || at.from >= at.to {
        return ""
    }
    return join(separator: " ", pieces: lines(substring(text, at.from, at.to)))
}

fn check(root: string) {
    val m = metrics()
    var bad = 0
    var checked = 0
    for file in design_files(root) {
        val text = read(file)
        val all = read_design.components_of(text)
        val known = read_design.constants_of(text)
        val records = read_design.records_of(text)
        for c in all {
            checked = checked + 1
            bad = bad + check_component(file, text, c, all, known, records, m)
        }
    }
    if bad > 0 {
        print(format(
            "pick_design: {} thing(s) a click cannot name, over {} component(s)",
            str(bad),
            str(checked)
        ))
        os.exit(1)
    }
    print(format(
        "pick_design: every control in {} component(s) names the node that drew it",
        str(checked)
    ))
}

fn number_said(args: [string], which: int, fallback: float) -> float {
    if which >= len(args) {
        return fallback
    }
    return switch parse_float(args[which]) {
        Ok(f) { f }
        Err(_) { fallback }
    }
}

fn main() {
    val args = os.args()
    if len(args) > 0 && args[0] == "--check" {
        check(if len(args) > 1 { args[1] } else { "src/main/ziman" })
        return
    }
    val path = if len(args) > 0 { args[0] } else { "src/main/ziman/gui/request_ui.zm" }
    val wanted = if len(args) > 1 { args[1] } else { "screen" }
    val x = number_said(args, 2, 100.0)
    val y = number_said(args, 3, 100.0)
    val text = read(path)
    val all = read_design.components_of(text)
    val c = switch component_named(wanted, all) {
        Some(got) { got }
        None {
            print(format("no component named {}", wanted))
            os.exit(1)
            all[0]
        }
    }
    val m = metrics()
    val shop = render_design.shop_of(
        read_design.constants_of(text),
        all,
        read_design.records_of(text),
        controls.default_style(),
        m
    )
    val drawn = render_design.render(c, [], shop)
    val spots = snapshot(shop.spots)
    val laid = widget.layout(render_design.widget_of(drawn), canvas, m)
    val p = geom.point_of(x, y)
    print(format("{} node(s) a click can name in {}", str(len(spots)), c.name))
    switch render_design.spot_at(laid, p, spots) {
        Some(spot) {
            val owner = switch component_named(spot.component, all) {
                Some(o) { o }
                None { c }
            }
            switch read_design.node_at(tree_of(owner), spot.path) {
                Some(node) {
                    val at = read_design.span_in_file(owner, node)
                    print(format(
                        "  {} of {} [{}..{}]",
                        read_design.path_text(spot.path),
                        spot.component,
                        str(at.from),
                        str(at.to)
                    ))
                    print(format("  {}", substring(text, at.from, at.to)))
                }
                None { print(format("  {} names no node", read_design.path_text(spot.path))) }
            }
        }
        None { print("  nothing there") }
    }
}
