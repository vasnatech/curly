#!/usr/bin/env bash
# `curly`, as this implementation runs it.
#
# The Rust implementation is a single native binary; this one is a Ziman program, so it needs the
# interpreter and the `--` that separates the interpreter's arguments from the program's. A shebang
# cannot do it: the kernel appends the script path *after* whatever the shebang line names, so the
# `--` would land in the wrong place.
#
# Override the interpreter with ZIMAN=/path/to/ziman.
set -euo pipefail

# **Resolved through symlinks, because the usual way to install this is one.** A bare
# `dirname "${BASH_SOURCE[0]}"` answers the *link's* directory, so a `curly` symlinked into
# ~/.local/bin went looking for ~/.local/src/main/ziman/curly.zm and failed with a module error
# naming a path nobody wrote. Walked by hand rather than with `readlink -f`, which is GNU-only and
# absent on macOS; plain `readlink` is everywhere.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  link_dir="$(cd -P "$(dirname "$target")" && pwd)"
  target="$(readlink "$target")"
  # A relative link is relative to the directory the link itself is in.
  case $target in
    /*) ;;
    *) target="$link_dir/$target" ;;
  esac
done
here="$(cd -P "$(dirname "$target")" && pwd)"

# **`gui` needs an interpreter with a window backend, and the default one has none.**
# `lib/ui/desktop/window.zm` keeps X11 behind a compile flag so that an ordinary `ziman` does not
# depend on a display -- which is the right default and means the window natives live only in the
# build `make gui` produces. So this prefers `ziman-gui` for that one subcommand when it can find
# one, and otherwise leaves the choice alone and lets the program report it.
interpreter="${ZIMAN:-ziman}"
if [ "${1:-}" = "gui" ] && [ -z "${ZIMAN:-}" ] && command -v ziman-gui >/dev/null 2>&1; then
  interpreter="ziman-gui"
fi

# Where the vendored font lives, for a standalone run. `gui/app.zm` prefers a system face and falls
# back to this; `CURLY_FONT` overrides both.
export CURLY_ROOT="${CURLY_ROOT:-$here/../..}"

exec "$interpreter" "$here/../src/main/ziman/curly.zm" -- "$@"
